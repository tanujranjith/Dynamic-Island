<UserControl x:Class="DynamicIsland.Windows.Views.AlarmListPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TimerEditorResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer x:Name="EditorScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <TextBlock Text="{Binding StorageWarning}" Foreground="#FFB86C" TextWrapping="Wrap" Margin="0,4" />
            <Expander Visibility="{Binding HasMissedAlerts, Converter={StaticResource BoolToVisibility}}" Header="Missed alerts" Foreground="#CCD0D8" Margin="0,6">
                <StackPanel>
                    <TextBlock Text="{Binding MissedSummary}" TextWrapping="Wrap" />
                    <Button Content="Clear summary" Command="{Binding ClearMissedCommand}" Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>
            <Border Background="#16FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,14,0,0" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                <StackPanel>
                    <ComboBox ItemsSource="{Binding Alarms}" DisplayMemberPath="Text" SelectedValuePath="Id" SelectedValue="{Binding SelectedAlarmId}" MinHeight="32" MaxDropDownHeight="220" AutomationProperties.Name="Selected alarm" />
                    <WrapPanel Margin="0,8,0,10">
                        <Button Content="Edit selected" Command="{Binding EditAlarmCommand}" Style="{StaticResource SettingsButton}" Margin="3" />
                        <Button Content="New alarm" Command="{Binding NewAlarmCommand}" Style="{StaticResource SettingsButton}" Margin="3" />
                    </WrapPanel>
                    <Grid>
                        <TextBlock Text="Alarm" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="{Binding AlarmStateText}" HorizontalAlignment="Right" Foreground="#7EB8FF" />
                    </Grid>
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding AlarmHour}" Padding="8,7" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Text="{Binding AlarmMinute}" Padding="8,7" Margin="0,0,6,0" />
                        <ComboBox Grid.Column="2" SelectedValue="{Binding AmPm}" SelectedValuePath="Content" Padding="8,5" Margin="0,0,6,0">
                            <ComboBoxItem Content="AM" />
                            <ComboBoxItem Content="PM" />
                        </ComboBox>
                        <TextBox Grid.Column="3" Text="{Binding AlarmLabel}" Padding="8,7" ToolTip="Optional label" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Repeat" Foreground="#C8D0DC" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding RepeatOptions}" SelectedItem="{Binding AlarmRepeat}" Padding="8,5" Margin="12,0,0,0" HorizontalAlignment="Left" MinWidth="130" />
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <CheckBox Content="Sun" IsChecked="{Binding Sunday}" Foreground="#C8D0DC" Margin="0,0,9,0" />
                        <CheckBox Content="Mon" IsChecked="{Binding Monday}" Foreground="#C8D0DC" Margin="0,0,9,0" />
                        <CheckBox Content="Tue" IsChecked="{Binding Tuesday}" Foreground="#C8D0DC" Margin="0,0,9,0" />
                        <CheckBox Content="Wed" IsChecked="{Binding Wednesday}" Foreground="#C8D0DC" Margin="0,0,9,0" />
                        <CheckBox Content="Thu" IsChecked="{Binding Thursday}" Foreground="#C8D0DC" Margin="0,0,9,0" />
                        <CheckBox Content="Fri" IsChecked="{Binding Friday}" Foreground="#C8D0DC" Margin="0,0,9,0" />
                        <CheckBox Content="Sat" IsChecked="{Binding Saturday}" Foreground="#C8D0DC" />
                    </WrapPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Every" Foreground="#C8D0DC" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding IntervalDays}" Padding="8,7" Margin="8,0,6,0" />
                        <TextBlock Grid.Column="2" Text="days · end" Foreground="#C8D0DC" VerticalAlignment="Center" />
                        <DatePicker Grid.Column="3" SelectedDate="{Binding RepeatEndDate}" Margin="8,0,0,0" />
                    </Grid>
                    <CheckBox Content="24-hour time" IsChecked="{Binding Use24Hour}" Foreground="#C8D0DC" Margin="0,10,0,0" />
                    <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="{Binding SaveAlarmText}" Command="{Binding SetAlarmCommand}" Style="{StaticResource SettingsButton}" Margin="4" />
                        <Button Content="Delete" Command="{Binding DeleteAlarmCommand}" Style="{StaticResource SettingsButton}" Background="#394252" Margin="4" />
                        <Button Content="Dismiss" Command="{Binding DismissAlarmCommand}" Style="{StaticResource SettingsButton}" Background="#C74343" Margin="4" />
                        <Button Content="Snooze 5m" Command="{Binding Snooze5Command}" Style="{StaticResource SettingsButton}" Background="#946C2B" Margin="4" />
                        <Button Content="Snooze 10m" Command="{Binding Snooze10Command}" Style="{StaticResource SettingsButton}" Background="#946C2B" Margin="4" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFB86C" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
