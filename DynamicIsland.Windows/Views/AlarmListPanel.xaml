<UserControl x:Class="DynamicIsland.Windows.Views.AlarmListPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TimerEditorResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <Border Margin="4,0" Background="#221A3152" BorderBrush="#332F4C70" BorderThickness="1" CornerRadius="18" Padding="28,24">
            <StackPanel>
                <TextBlock Text="{Binding StorageWarning}" Foreground="#FFFFB86C" TextWrapping="Wrap" Margin="0,0,0,6" />
                <Expander Visibility="{Binding HasMissedAlerts, Converter={StaticResource BoolToVisibility}}" Header="Missed alerts" Foreground="#CCD0D8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding MissedSummary}" TextWrapping="Wrap" />
                        <Button Content="Clear summary" Command="{Binding ClearMissedCommand}" Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Expander>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Alarm" FontSize="20" FontWeight="SemiBold" Foreground="#FFF5F5F7" />
                        <TextBlock Text="Wake up. Do more." Foreground="#FF8EA7CA" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding AlarmStateText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FF51B8FF" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="260" />
                </Grid>
                <ComboBox ItemsSource="{Binding Alarms}" DisplayMemberPath="Text" SelectedValuePath="Id" SelectedValue="{Binding SelectedAlarmId}" MinHeight="36" MaxDropDownHeight="220" HorizontalAlignment="Stretch" Margin="0,16,0,0" AutomationProperties.Name="Selected alarm" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Edit selected" Command="{Binding EditAlarmCommand}" Style="{StaticResource TimerSurfaceButton}" Margin="0,0,8,8" />
                    <Button Content="New alarm" Command="{Binding NewAlarmCommand}" Style="{StaticResource TimerSurfaceButton}" Margin="0,0,0,8" />
                </WrapPanel>
                <TextBlock Text="Time" Foreground="#FFB7C7DF" FontSize="14" Margin="0,12,0,8" />
                <WrapPanel HorizontalAlignment="Center">
                    <StackPanel Width="150" Margin="5">
                        <TextBox Text="{Binding AlarmHour}" Style="{StaticResource TimerTextBox}" FontSize="42" FontWeight="SemiBold" HorizontalContentAlignment="Center" Padding="8,2" />
                        <TextBlock Text="Hour" Foreground="#FF9DB4D7" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="5">
                        <TextBox Text="{Binding AlarmMinute}" Style="{StaticResource TimerTextBox}" FontSize="42" FontWeight="SemiBold" HorizontalContentAlignment="Center" Padding="8,2" />
                        <TextBlock Text="Minute" Foreground="#FF9DB4D7" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Width="130" Margin="5">
                        <ComboBox SelectedValue="{Binding AmPm}" SelectedValuePath="Content" FontSize="20" HorizontalContentAlignment="Center" MinHeight="68">
                            <ComboBoxItem Content="AM" />
                            <ComboBoxItem Content="PM" />
                        </ComboBox>
                        <TextBlock Text="AM / PM" Foreground="#FF9DB4D7" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="Repeat" Foreground="#FFB7C7DF" FontSize="14" Margin="0,18,0,8" />
                <WrapPanel HorizontalAlignment="Center">
                    <CheckBox Content="S" IsChecked="{Binding Sunday}" Foreground="#FFB7C7DF" Margin="6" FontSize="15" />
                    <CheckBox Content="M" IsChecked="{Binding Monday}" Foreground="#FF51B8FF" Margin="6" FontSize="15" />
                    <CheckBox Content="T" IsChecked="{Binding Tuesday}" Foreground="#FF51B8FF" Margin="6" FontSize="15" />
                    <CheckBox Content="W" IsChecked="{Binding Wednesday}" Foreground="#FF51B8FF" Margin="6" FontSize="15" />
                    <CheckBox Content="T" IsChecked="{Binding Thursday}" Foreground="#FF51B8FF" Margin="6" FontSize="15" />
                    <CheckBox Content="F" IsChecked="{Binding Friday}" Foreground="#FF51B8FF" Margin="6" FontSize="15" />
                    <CheckBox Content="S" IsChecked="{Binding Saturday}" Foreground="#FFB7C7DF" Margin="6" FontSize="15" />
                </WrapPanel>
                <TextBlock Text="Label (optional)" Foreground="#FF9DB4D7" Margin="0,14,0,6" />
                <TextBox Text="{Binding AlarmLabel}" ToolTip="Optional label" />
                <TextBlock Text="Schedule" Foreground="#FFB7C7DF" FontSize="14" Margin="0,14,0,8" />
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="Repeat" Foreground="#FF9DB4D7" VerticalAlignment="Center" Margin="5" />
                    <ComboBox ItemsSource="{Binding RepeatOptions}" SelectedItem="{Binding AlarmRepeat}" MinWidth="140" Margin="5" />
                    <TextBlock Text="Every" Foreground="#FF9DB4D7" VerticalAlignment="Center" Margin="5" />
                    <TextBox Text="{Binding IntervalDays}" Width="64" Margin="5" />
                    <DatePicker SelectedDate="{Binding RepeatEndDate}" MinWidth="140" Margin="5" />
                </WrapPanel>
                <CheckBox Content="24-hour time" IsChecked="{Binding Use24Hour}" Foreground="#FFB7C7DF" Margin="5,8,0,0" />
                <WrapPanel HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Content="{Binding SaveAlarmText}" Command="{Binding SetAlarmCommand}" Style="{StaticResource TimerPrimaryButton}" MinWidth="210" MinHeight="54" FontSize="15" Margin="5" />
                    <Button Content="Delete" Command="{Binding DeleteAlarmCommand}" Style="{StaticResource TimerSurfaceButton}" MinWidth="120" MinHeight="54" Margin="5" />
                    <Button Content="Dismiss" Command="{Binding DismissAlarmCommand}" Style="{StaticResource TimerSurfaceButton}" Background="#FF713A48" MinWidth="120" MinHeight="54" Margin="5" />
                </WrapPanel>
                <WrapPanel HorizontalAlignment="Center">
                    <Button Content="Snooze 5m" Command="{Binding Snooze5Command}" Style="{StaticResource TimerSurfaceButton}" Background="#FF704E27" Margin="5" />
                    <Button Content="Snooze 10m" Command="{Binding Snooze10Command}" Style="{StaticResource TimerSurfaceButton}" Background="#FF704E27" Margin="5" />
                </WrapPanel>
                <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFFFB86C" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
