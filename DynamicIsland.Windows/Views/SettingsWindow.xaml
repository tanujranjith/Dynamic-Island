<Window x:Class="DynamicIsland.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island Settings" Width="1240" Height="820" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#0E1116" Foreground="#F5F5F7"
        FontFamily="Segoe UI Variable Text" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#151A21" />
        <SolidColorBrush x:Key="SurfaceRaised" Color="#1B212A" />
        <SolidColorBrush x:Key="Hairline" Color="#303741" />
        <SolidColorBrush x:Key="Muted" Color="#9BA4AF" />
        <SolidColorBrush x:Key="Blue" Color="#0A84FF" />

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="PageDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,22,0,9" />
        </Style>
        <Style x:Key="InsetGroup" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="PreferenceRow" TargetType="Border">
            <Setter Property="Padding" Value="15,11" />
            <Setter Property="BorderBrush" Value="#25303A45" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="LastPreferenceRow" TargetType="Border" BasedOn="{StaticResource PreferenceRow}">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,24,0" />
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="44" Height="25" CornerRadius="13" Background="#3A4049">
                            <Ellipse x:Name="Thumb" Width="19" Height="19" Fill="#F5F5F7" HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Blue}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="154" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Background" Value="#242A33" />
            <Setter Property="BorderBrush" Value="#3A424D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource Field}">
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F5F5F7" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="6" Margin="3,2" Padding="10,7"><ContentPresenter ContentSource="Content" /></Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#0A84FF" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#334F89C9" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboChrome" Background="#242A33" BorderBrush="#3A424D" BorderThickness="1" CornerRadius="8" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#657385" /></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#0A84FF" /></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboChrome" Property="Opacity" Value="0.45" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock Text="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=Select}"
                                       Margin="11,0,31,0" VerticalAlignment="Center" Foreground="#F5F5F7"
                                       FontSize="12.5" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="9"
                                       HorizontalAlignment="Right" Margin="0,0,11,0" VerticalAlignment="Center"
                                       Foreground="#9BA4AF" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PlacementTarget="{Binding ElementName=DropDownToggle}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#FA252B34" BorderBrush="#46505C" BorderThickness="1"
                                        CornerRadius="9" Margin="0,5,0,0" Padding="2"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="#000000" /></Border.Effect>
                                    <ScrollViewer MaxHeight="260" CanContentScroll="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldText" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
        <Style x:Key="FieldSlider" TargetType="Slider">
            <Setter Property="Width" Value="166" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#39414C" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="#0A84FF" VerticalAlignment="Center" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                                <Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#F5F5F7" Stroke="#D8DEE6" StrokeThickness="1"><Ellipse.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.35" /></Ellipse.Effect></Ellipse></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopTab" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B2BAC5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,15,14,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons" FontSize="19" HorizontalAlignment="Center" />
                                <ContentPresenter Margin="0,7,0,0" HorizontalAlignment="Center" />
                                <Border x:Name="Indicator" Height="2" Margin="-8,10,-8,0" CornerRadius="1" Background="{StaticResource Blue}" Opacity="0" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#F5F5F7" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Blue}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#242A33" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="BorderBrush" Value="#3A424D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#303844" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PreviewButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="3,0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" /><Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#FF2B2B30" /><Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Live preview workspace -->
        <Border Grid.Column="0" BorderBrush="#303741" BorderThickness="0,0,1,0" ClipToBounds="True">
            <Grid>
                <Image Source="/DynamicIsland.Windows;component/Assets/settings-preview-backdrop.png" Stretch="UniformToFill" Opacity="0.82" />
                <Border Background="#48080B10" />
                <Grid Margin="34,30,30,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Dynamic Island" FontFamily="Segoe UI Variable Display" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="Preview and customise your native Windows overlay" FontSize="13.5" Foreground="#ADB6C2" Margin="0,6,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Width="310" Height="42" Margin="0,28,0,0" CornerRadius="21" Background="#90171C23" BorderBrush="#3B4653" BorderThickness="1" HorizontalAlignment="Center">
                        <Grid Margin="3">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button x:Name="CompactPreviewButton" Content="Compact" Click="CompactPreview_Click" Background="#39414D" Foreground="White" BorderThickness="0" Cursor="Hand">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="17"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Button.Template>
                            </Button>
                            <Button x:Name="ExpandedPreviewButton" Grid.Column="1" Content="Expanded" Click="ExpandedPreview_Click" Background="Transparent" Foreground="#A7AFBA" BorderThickness="0" Cursor="Hand">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="17"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid x:Name="PreviewIslandData" Grid.Row="2" MouseEnter="Preview_MouseEnter" MouseLeave="Preview_MouseLeave">
                        <Border x:Name="PreviewPill" Width="230" Height="62" CornerRadius="{Binding IslandCornerRadius}" Background="{Binding IslandSurfaceBrush}" BorderBrush="{Binding PanelBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,62,0,0">
                            <Border.Resources>
                                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" /><Setter Property="FontFamily" Value="{Binding UiFontFamily}" /></Style>
                            </Border.Resources>
                            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="7" Opacity="0.55" Color="#000000" /></Border.Effect>
                            <Grid ClipToBounds="True">
                                <!-- Compact live state - MUST stay pixel-identical to IslandWindow.xaml CompactContent.
                                     Any layout change here must be mirrored there, otherwise titles like
                                     "Outside..." truncate differently in preview vs the live pill (see fix for
                                     outs... vs Outside T... mismatch). Uses same columns/margins/album binding
                                     and status lane (divider + RAM + Clock + Battery). -->
                                <Grid x:Name="CompactPreviewContent" Margin="10,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid Width="{Binding CompactAlbumSize}" Height="{Binding CompactAlbumSize}" VerticalAlignment="Center">
                                        <Border CornerRadius="{Binding CompactIconCorner}" Background="{Binding IslandCardBrush}">
                                            <TextBlock Text="{Binding CompactGlyph}" FontFamily="Segoe Fluent Icons" FontSize="{Binding CompactGlyphFontSize}" Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- The Settings preview stays demonstrative even when the user has
                                             temporarily disabled Media/album art in the real island. To keep
                                             truncation realistic we keep the same container sizes as the live
                                             island and use HasArtwork (preview) vs ShowCompactArt (live).
                                             Size bindings are already aliased to CompactAlbumSize. -->
                                        <Border CornerRadius="{Binding CompactIconCorner}" ClipToBounds="True"
                                                Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" /></Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="11,0,13,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MediaTitle}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding MediaTitleFontSize}" FontWeight="SemiBold" Foreground="{Binding PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MediaArtist}" Margin="0,2,0,0" FontFamily="{Binding UiFontFamily}" FontSize="{Binding MediaArtistFontSize}" Foreground="{Binding SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="1" Height="30" Margin="0,0,12,0" Background="{Binding IslandDividerBrush}"
                                                Visibility="{Binding ShowCompactRam, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Margin="0,0,13,0" Visibility="{Binding ShowCompactRam, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="RAM" FontFamily="{Binding UiFontFamily}" FontSize="8" Foreground="{Binding SecondaryTextBrush}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding RamText}" Margin="0,1,0,0" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactSecondaryFontSize}" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ClockTimeText}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactClockFontSize}" FontWeight="SemiBold"
                                                       Visibility="{Binding ShowClock, Converter={StaticResource BoolToVisibility}}"
                                                       Foreground="{Binding PrimaryTextBrush}" HorizontalAlignment="Right" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Right"
                                                        Visibility="{Binding ShowBattery, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding BatteryGlyph}" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                           Foreground="{Binding SecondaryTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding BatteryText}" Margin="4,0,0,0" FontFamily="{Binding UiFontFamily}" FontSize="9.5"
                                                           Foreground="{Binding SecondaryTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Expanded live state -->
                                <Grid x:Name="ExpandedPreviewContent" Visibility="Collapsed" Opacity="0" Margin="17">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid Width="{Binding PreviewExpandedAlbumSize}" Height="{Binding PreviewExpandedAlbumSize}" Margin="0,0,8,0">
                                        <Border CornerRadius="{Binding PreviewExpandedIconCorner}" Background="{Binding IslandCardBrush}"><TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="{Binding SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <Border CornerRadius="{Binding PreviewExpandedIconCorner}" ClipToBounds="True" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}"><Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" /></Border.Background></Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="9,3,8,0">
                                        <TextBlock Text="{Binding MediaTitle}" FontSize="{Binding ExpandedMediaTitleFontSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MediaArtist}" FontSize="{Binding ExpandedMediaArtistFontSize}" Foreground="{Binding SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        <ProgressBar Value="{Binding MediaProgress, Mode=OneWay}" Maximum="100" Height="3" Margin="0,10,0,0" Foreground="{Binding AccentBrush}" Background="{Binding IslandDividerBrush}" BorderThickness="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="{Binding VolumeGlyph}" Command="{Binding ToggleMuteCommand}" Style="{StaticResource PreviewButton}" ToolTip="Mute" />
                                        <Button Content="&#xE712;" Style="{StaticResource PreviewButton}" IsHitTestVisible="False" />
                                    </StackPanel>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Background="#151517" CornerRadius="13" Padding="11,9">
                                            <StackPanel><TextBlock Text="VOLUME" FontSize="8.5" Foreground="#8E8E93" /><TextBlock Text="{Binding VolumeText}" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="#151517" CornerRadius="13" Padding="11,9">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="MEMORY" FontSize="8.5" Foreground="#8E8E93" /><TextBlock Text="{Binding RamText}" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                                                <StackPanel Grid.Column="1"><TextBlock Text="NETWORK" FontSize="8.5" Foreground="#8E8E93" /><TextBlock Text="{Binding NetText}" FontSize="10" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="4" Background="#151517" CornerRadius="13" Padding="11,9">
                                            <StackPanel><TextBlock Text="{Binding ClockText}" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="{Binding DateText}" FontSize="9.5" Foreground="#8E8E93" Margin="0,5,0,0" /></StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Command="{Binding RecenterCommand}" Style="{StaticResource ActionButton}" Foreground="#69B5FF" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81D;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" /><TextBlock Text="Recenter island" /></StackPanel>
                        </Button>
                        <Button Click="OpenTimer_Click" Style="{StaticResource ActionButton}" Foreground="#69B5FF">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" /><TextBlock Text="Open timer" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Preferences -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border BorderBrush="#303741" BorderThickness="0,0,0,1" Background="#11151B">
                <UniformGrid Rows="1" Columns="6" Margin="24,0">
                    <ToggleButton x:Name="ContentTab" Content="Island Content" Tag="&#xE713;" Style="{StaticResource TopTab}" CommandParameter="content" Click="Section_Click" />
                    <ToggleButton x:Name="AppearanceTab" Content="Appearance" Tag="&#xE790;" Style="{StaticResource TopTab}" CommandParameter="appearance" Click="Section_Click" />
                    <ToggleButton x:Name="PositionTab" Content="Position" Tag="&#xE809;" Style="{StaticResource TopTab}" CommandParameter="position" Click="Section_Click" />
                    <ToggleButton x:Name="ActivitiesTab" Content="Live Activities" Tag="&#xE753;" Style="{StaticResource TopTab}" CommandParameter="activities" Click="Section_Click" />
                    <ToggleButton x:Name="QTab" Content="Q Assistant" Tag="Q" Style="{StaticResource TopTab}" CommandParameter="q" Click="Section_Click" />
                    <ToggleButton x:Name="AdvancedTab" Content="Advanced" Tag="&#xE9F5;" Style="{StaticResource TopTab}" CommandParameter="advanced" Click="Section_Click" />
                </UniformGrid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28,32,34">
                <Grid>
                    <!-- Island Content -->
                    <StackPanel x:Name="ContentPage">
                        <TextBlock Text="Island Content" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Choose what remains available in the compact and expanded island." Style="{StaticResource PageDescription}" />
                        <TextBlock Text="ALWAYS AVAILABLE" Style="{StaticResource GroupLabel}" Margin="0,0,0,9" />
                        <Border Style="{StaticResource InsetGroup}"><StackPanel>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" Foreground="#C9D1DA" /><TextBlock Grid.Column="1" Text="Media" Style="{StaticResource RowTitle}" /><CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowMedia}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" Foreground="#C9D1DA" /><StackPanel Grid.Column="1"><TextBlock Text="Album art in compact" Style="{StaticResource RowTitle}" /><TextBlock Text="Show the track cover instead of the activity icon." Style="{StaticResource RowDescription}" /></StackPanel><CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowAlbumArtInCompact}" /></Grid></Border>
