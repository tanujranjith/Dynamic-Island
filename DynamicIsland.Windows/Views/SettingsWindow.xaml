                        <Border Style="{StaticResource InsetGroup}"><StackPanel>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Notification history" Style="{StaticResource RowTitle}" /><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotificationHistoryEnabled}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Notification filter" Style="{StaticResource RowTitle}" /><ComboBox Grid.Column="1" Style="{StaticResource FieldCombo}" Tag="{Binding NotificationFilterMode}" ItemsSource="{Binding NotificationFilterOptions}" SelectedItem="{Binding NotificationFilterMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="App list" Style="{StaticResource RowTitle}" /><TextBox Grid.Column="1" Style="{StaticResource FieldText}" Text="{Binding NotificationAppFilter, UpdateSourceTrigger=LostFocus}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Next meeting with Join" Style="{StaticResource RowTitle}" /><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowNextMeeting}" /></Grid></Border>
<DockPanel Margin="16,0,16,10" DataContext="{Binding DataContext, ElementName=PreviewIslandData}"><Button DockPanel.Dock="Right" Content="Windows Settings" Command="{Binding CalendarSettingsCommand}" Style="{StaticResource SettingsButton}" Margin="6,0,0,0" /><Button DockPanel.Dock="Right" Content="Set up / Retry" Command="{Binding RetryCalendarCommand}" Style="{StaticResource SettingsButton}" Margin="6,0,0,0" /><TextBlock Text="{Binding CalendarStatusText}" Foreground="#9FAABD" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <Border Style="{StaticResource LastPreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Clipboard history button" Style="{StaticResource RowTitle}" /><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowClipboard}" /></Grid></Border>
<DockPanel Margin="16,0,16,10" DataContext="{Binding DataContext, ElementName=PreviewIslandData}"><Button DockPanel.Dock="Right" Content="Windows Settings" Command="{Binding ClipboardSettingsCommand}" Style="{StaticResource SettingsButton}" Margin="6,0,0,0" /><Button DockPanel.Dock="Right" Content="Set up / Retry" Command="{Binding RetryClipboardCommand}" Style="{StaticResource SettingsButton}" Margin="6,0,0,0" /><TextBlock Text="{Binding ClipboardStatusText}" Foreground="#9FAABD" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                        </StackPanel></Border>
                    </StackPanel>

                    <!-- Q Assistant -->
                    <StackPanel x:Name="QPage" Visibility="Collapsed">
                        <TextBlock Text="Q Assistant" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Ask what is on your screen or get a concise suggestion for what to say next." Style="{StaticResource PageDescription}" />
                        <TextBlock Text="GENERAL" Style="{StaticResource GroupLabel}" Margin="0,0,0,9" />
                        <Border Style="{StaticResource InsetGroup}"><StackPanel>
                           <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Enable Q" Style="{StaticResource RowTitle}" /><TextBlock Text="Show the Q action in the Island and enable its global shortcut." Style="{StaticResource RowDescription}" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding QEnabled}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}">
                                <StackPanel>
                                    <TextBlock Text="Q activation shortcuts" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Enable any combination. Each shortcut runs the same Q action." Style="{StaticResource RowDescription}" />
                                    <WrapPanel Margin="0,12,0,4">
                                        <CheckBox Content="Ctrl + Alt + Q" IsChecked="{Binding QCtrlAltQ, Mode=TwoWay}" Foreground="{DynamicResource SettingsTextBrush}" Margin="0,0,24,12" />
                                        <CheckBox Content="Shift + A" IsChecked="{Binding QShiftA, Mode=TwoWay}" Foreground="{DynamicResource SettingsTextBrush}" Margin="0,0,24,12" />
                                        <CheckBox Content="Type var (lowercase, within 2 seconds)" IsChecked="{Binding QVarSequence, Mode=TwoWay}" Foreground="{DynamicResource SettingsTextBrush}" Margin="0,0,24,12" />
                                        <CheckBox Content="Shift + comma (&lt;)" IsChecked="{Binding QShiftComma, Mode=TwoWay}" Foreground="{DynamicResource SettingsTextBrush}" Margin="0,0,24,12" />
                                        <CheckBox Content="Shift + period (&gt;)" IsChecked="{Binding QShiftPeriod, Mode=TwoWay}" Foreground="{DynamicResource SettingsTextBrush}" Margin="0,0,24,12" />
                                    </WrapPanel>
                                    <TextBlock Text="Typing var leaves it in your text. Shift shortcuts can interrupt normal typing." Style="{StaticResource RowDescription}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding QActivationStatus}" Foreground="#FFFF9F0A" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                             <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Auto-expand island for Q" Style="{StaticResource RowTitle}" /><TextBlock Text="Expand the island automatically when the Q shortcut or Q action is used." Style="{StaticResource RowDescription}" TextWrapping="Wrap" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding QAutoExpandIsland}" /></Grid></Border>
                            <Border Style='{StaticResource PreferenceRow}'><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width='Auto' /></Grid.ColumnDefinitions><StackPanel><TextBlock Text='Auto-close Q after response' Style='{StaticResource RowTitle}' /><TextBlock Text='Close the Q session automatically after a response finishes.' Style='{StaticResource RowDescription}' TextWrapping='Wrap' /></StackPanel><CheckBox Grid.Column='1' Style='{StaticResource ToggleSwitch}' IsChecked='{Binding QAutoCloseAfterResponse}' /></Grid></Border>
                            <Border Style='{StaticResource PreferenceRow}'><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width='Auto' /></Grid.ColumnDefinitions><StackPanel><TextBlock Text='Q auto-close delay' Style='{StaticResource RowTitle}' /><TextBlock Text='How long to keep the completed response visible before closing Q.' Style='{StaticResource RowDescription}' TextWrapping='Wrap' /></StackPanel><StackPanel Grid.Column='1' Orientation='Horizontal'><TextBlock Width='48' Margin='0,0,10,0' Text='{Binding QAutoCloseDelaySeconds, StringFormat={}{0}s}' Foreground='#FF9DA8B8' VerticalAlignment='Center' TextAlignment='Right' /><Slider Style='{StaticResource FieldSlider}' Minimum='1' Maximum='300' TickFrequency='1' IsSnapToTickEnabled='True' Value='{Binding QAutoCloseDelaySeconds}' /></StackPanel></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Hotkey quick action" Style="{StaticResource RowTitle}" /><TextBlock Text="Optionally run a Q quick shortcut immediately after the selected Q shortcut opens and captures the screen." Style="{StaticResource RowDescription}" /></StackPanel><ComboBox Grid.Column="1" Width="190" Style="{StaticResource FieldCombo}" ItemsSource="{Binding QHotkeyShortcutOptions}" SelectedItem="{Binding QHotkeyShortcut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Inference provider" Style="{StaticResource RowTitle}" /><TextBlock Text="Switch here or directly in the Q panel." Style="{StaticResource RowDescription}" /></StackPanel><ComboBox Grid.Column="1" Style="{StaticResource FieldCombo}" ItemsSource="{Binding QProviderOptions}" SelectedValuePath="Id" SelectedValue="{Binding QSelectedProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Model" Style="{StaticResource RowTitle}" /><ComboBox Grid.Column="1" Width="220" IsEditable="True" Style="{StaticResource FieldCombo}" ItemsSource="{Binding QModelOptions}" Text="{Binding QSelectedModel, UpdateSourceTrigger=LostFocus}" SelectedItem="{Binding QSelectedModel, Mode=TwoWay}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}" Visibility="{Binding QIsCodexSelected, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="ChatGPT/Codex account" Style="{StaticResource RowTitle}" /><TextBlock Text="{Binding QCodexAccountStatus}" Style="{StaticResource RowDescription}" TextWrapping="Wrap" MaxWidth="420" /><TextBlock Text="{Binding QCodexUsageStatus}" Style="{StaticResource RowDescription}" TextWrapping="Wrap" MaxWidth="420" /></StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="{Binding QCodexActionLabel}" Command="{Binding SignInCodexCommand}" Style="{StaticResource ActionButton}" />
                                        <Button Content="Cancel" Command="{Binding CancelCodexLoginCommand}" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Visibility="{Binding QCodexLoginPending, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Sign out" Command="{Binding SignOutCodexCommand}" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Visibility="{Binding QCodexIsConnected, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Reasoning effort" Style="{StaticResource RowTitle}" /><TextBlock Text="Auto uses the provider default; explicit values are sent when supported by the selected model." Style="{StaticResource RowDescription}" /></StackPanel><ComboBox Grid.Column="1" Width="130" Style="{StaticResource FieldCombo}" ItemsSource="{Binding QReasoningEffortOptions}" SelectedItem="{Binding QReasoningEffort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}">
                                <StackPanel>
                                    <TextBlock Text="Provider API keys" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Save a separate key for each provider. Select another provider above to add its key; your other keys stay saved. Keys use Windows user-scoped encryption, outside settings.json." Style="{StaticResource RowDescription}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding QSavedKeyProviders}" Foreground="#FF64ADFF" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <StackPanel Visibility="{Binding QShowApiKey, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding QApiKeyStatus}" Style="{StaticResource RowDescription}" Margin="0,8,0,8" />
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="QApiKeyBox" MinWidth="180" Height="32" VerticalContentAlignment="Center" ToolTip="Paste a key for the selected provider, then click Save key" AutomationProperties.Name="Provider API key" />
                                            <Button Grid.Column="1" Content="Save key" Click="SaveQApiKey_Click" Style="{StaticResource ActionButton}" Margin="8,0,0,0" />
                                            <Button Grid.Column="2" Content="Remove key" Click="RemoveQApiKey_Click" Style="{StaticResource ActionButton}" Margin="8,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Capture source" Style="{StaticResource RowTitle}" /><ComboBox Grid.Column="1" Style="{StaticResource FieldCombo}" ItemsSource="{Binding QCaptureModeOptions}" SelectedItem="{Binding QCaptureMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Send screen image" Style="{StaticResource RowTitle}" /><TextBlock Text="Vision-capable models receive the captured PNG along with OCR text." Style="{StaticResource RowDescription}" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding QIncludeScreenImage}" /></Grid></Border>
                            <Border Style="{StaticResource LastPreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Ollama base URL" Style="{StaticResource RowTitle}" /><TextBox Grid.Column="1" Style="{StaticResource FieldText}" Text="{Binding QOllamaBaseUrl, UpdateSourceTrigger=LostFocus}" /></Grid></Border>
                        </StackPanel></Border>
                        <Border Style="{StaticResource PreferenceRow}" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding QConnectionStatus}" Style="{StaticResource RowDescription}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Test connection" Command="{Binding TestQCommand}" Style="{StaticResource ActionButton}" /></Grid></Border>
                        <TextBlock Text="SYSTEM PROMPTS" Style="{StaticResource GroupLabel}" />
                        <Border Style="{StaticResource InsetGroup}"><StackPanel>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="Ask instructions" Style="{StaticResource RowTitle}" /><TextBlock Grid.Row="1" Text="Optional instructions added after Q’s built-in Ask behavior." Style="{StaticResource RowDescription}" /><TextBox Grid.RowSpan="2" Grid.Column="1" Width="300" Height="86" Margin="16,0,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource FieldText}" Text="{Binding QAskSystemPrompt, UpdateSourceTrigger=LostFocus}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="Say instructions" Style="{StaticResource RowTitle}" /><TextBlock Grid.Row="1" Text="Optional instructions added after Q’s built-in Say behavior." Style="{StaticResource RowDescription}" /><TextBox Grid.RowSpan="2" Grid.Column="1" Width="300" Height="86" Margin="16,0,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource FieldText}" Text="{Binding QSaySystemPrompt, UpdateSourceTrigger=LostFocus}" /></Grid></Border>
                            <Border Style="{StaticResource LastPreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Restore built-in prompts" Style="{StaticResource RowTitle}" /><Button Grid.Column="1" Content="Reset" Command="{Binding ResetQPromptsCommand}" Style="{StaticResource ActionButton}" /></Grid></Border>
                        </StackPanel></Border>
                        <TextBlock Text="QUICK SHORTCUTS" Style="{StaticResource GroupLabel}" />
                        <Border Style="{StaticResource InsetGroup}"><StackPanel>
                            <TextBlock Text="Create one-click prompt buttons for Q chat." Margin="16,14,16,10" Style="{StaticResource RowDescription}" />
                            <ItemsControl ItemsSource="{Binding QShortcutList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="10,0,10,10" Padding="12" Background="#FF121923" BorderBrush="#FF29364A" BorderThickness="1" CornerRadius="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="Button name" Style="{StaticResource RowDescription}" />
                                                    <TextBox Style="{StaticResource FieldText}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" ToolTip="Text shown on the Q button" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="Underlying prompt" Style="{StaticResource RowDescription}" />
                                                    <TextBox Height="54" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource FieldText}" Text="{Binding Prompt, UpdateSourceTrigger=LostFocus}" ToolTip="Prompt sent when the button is clicked" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal">
                                                    <Button Content="↑" Command="{Binding DataContext.MoveQShortcutUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource ActionButton}" Width="32" Padding="0" Margin="0,0,5,0" ToolTip="Move up" />
                                                    <Button Content="↓" Command="{Binding DataContext.MoveQShortcutDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource ActionButton}" Width="32" Padding="0" Margin="0,0,5,0" ToolTip="Move down" />
                                                    <Button Content="Remove" Command="{Binding DataContext.RemoveQShortcutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource ActionButton}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="＋ Add shortcut" Command="{Binding AddQShortcutCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="16,0,16,14" />
                        </StackPanel></Border>
                        <TextBlock Text="REQUEST LIMITS" Style="{StaticResource GroupLabel}" />
                        <Border Style="{StaticResource InsetGroup}"><StackPanel>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Timeout seconds" Style="{StaticResource RowTitle}" /><Slider Grid.Column="1" Style="{StaticResource FieldSlider}" Minimum="10" Maximum="300" Value="{Binding QTimeoutSeconds}" /></Grid></Border>
                            <Border Style="{StaticResource LastPreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Maximum response tokens" Style="{StaticResource RowTitle}" /><TextBlock Text="Includes hidden reasoning tokens. Default: 8,192." Style="{StaticResource RowDescription}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Width="56" Margin="0,0,10,0" Text="{Binding QMaxResponseTokens, StringFormat={}{0:N0}}" Foreground="#FF9DA8B8" VerticalAlignment="Center" TextAlignment="Right" /><Slider Style="{StaticResource FieldSlider}" Minimum="2048" Maximum="32768" TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding QMaxResponseTokens}" /></StackPanel></Grid></Border>
                        </StackPanel></Border>
                    </StackPanel>

                    <!-- Advanced -->
                    <StackPanel x:Name="AdvancedPage" Visibility="Collapsed">
                        <TextBlock Text="Advanced" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Media detail, warnings, profiles, backup, and diagnostics." Style="{StaticResource PageDescription}" />
                        <TextBlock Text="MEDIA" Style="{StaticResource GroupLabel}" Margin="0,0,0,9" />
                        <Border Style="{StaticResource InsetGroup}"><StackPanel>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Preferred media app" Style="{StaticResource RowTitle}" /><ComboBox Grid.Column="1" Style="{StaticResource FieldCombo}" Tag="{Binding SelectedMediaApp}" ItemsSource="{Binding AvailableMediaApps}" SelectedItem="{Binding SelectedMediaApp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Media progress ring" Style="{StaticResource RowTitle}" /><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowMediaProgressRing}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Song time remaining" Style="{StaticResource RowTitle}" /><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowSongTimeRemaining}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Scroll long titles" Style="{StaticResource RowTitle}" /><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ScrollLongTitles}" /></Grid></Border>
                            <Border Style="{StaticResource LastPreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Click artwork to open app" Style="{StaticResource RowTitle}" /><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ClickArtOpensApp}" /></Grid></Border>
                        </StackPanel></Border>
                        <TextBlock Text="WARNINGS" Style="{StaticResource GroupLabel}" />
                        <Border Style="{StaticResource InsetGroup}"><StackPanel>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Battery time remaining" Style="{StaticResource RowTitle}" /><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowBatteryTime}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Low-battery warning" Style="{StaticResource RowTitle}" /><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LowBatteryWarning}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Low-battery threshold" Style="{StaticResource RowTitle}" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Slider Style="{StaticResource FieldSlider}" Minimum="5" Maximum="50" Value="{Binding LowBatteryThreshold}" /><TextBlock Text="{Binding LowBatteryThreshold, StringFormat={}{0}%}" Width="48" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" /></StackPanel></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Volume warning" Style="{StaticResource RowTitle}" /><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VolumeWarningEnabled}" /></Grid></Border>
                            <Border Style="{StaticResource LastPreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Volume threshold" Style="{StaticResource RowTitle}" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Slider Style="{StaticResource FieldSlider}" Minimum="10" Maximum="100" Value="{Binding VolumeWarningThreshold}" /><TextBlock Text="{Binding VolumeWarningThreshold, StringFormat={}{0}%}" Width="48" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" /></StackPanel></Grid></Border>
                        </StackPanel></Border>
                        <TextBlock Text="PROFILES &amp; BACKUP" Style="{StaticResource GroupLabel}" />
                        <Border Style="{StaticResource InsetGroup}"><StackPanel>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox Style="{StaticResource FieldCombo}" Tag="{Binding SelectedPreset}" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Apply" Command="{Binding ApplyPresetCommand}" Style="{StaticResource ActionButton}" Margin="0,0,7,0" /><Button Content="Delete" Command="{Binding DeletePresetCommand}" Style="{StaticResource ActionButton}" Foreground="#FF9F9F" /></StackPanel></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Style="{StaticResource FieldText}" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" /><Button Grid.Column="1" Content="Save current as preset" Command="{Binding SavePresetCommand}" Style="{StaticResource ActionButton}" /></Grid></Border>
                            <Border Style="{StaticResource LastPreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Import or export settings" Style="{StaticResource RowTitle}" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Import" Command="{Binding ImportCommand}" Style="{StaticResource ActionButton}" Margin="0,0,7,0" /><Button Content="Export" Command="{Binding ExportCommand}" Style="{StaticResource ActionButton}" /></StackPanel></Grid></Border>
                        </StackPanel></Border>
                        <TextBlock Text="DEVELOPER" Style="{StaticResource GroupLabel}" />
                        <Border Style="{StaticResource InsetGroup}"><StackPanel>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Debug overlay" Style="{StaticResource RowTitle}" /><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DebugOverlay}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Show Island in screenshots" Style="{StaticResource RowTitle}" /><TextBlock Text="Turn on only when you want the Island included in screenshots; off excludes it where Windows supports capture affinity." Style="{StaticResource RowDescription}" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowIslandInScreenshots}" /></Grid></Border>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Debug logging" Style="{StaticResource RowTitle}" /><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DebugLogging}" /></Grid></Border>
                            <Border Style="{StaticResource LastPreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Show island in Alt-Tab" Style="{StaticResource RowTitle}" /><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowInAltTab}" /></Grid></Border>
                        </StackPanel></Border>
                        <TextBlock Text="ABOUT" Style="{StaticResource GroupLabel}" />
                        <Border Style="{StaticResource InsetGroup}"><StackPanel>
                            <Border Style="{StaticResource PreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Dynamic Island for Windows" Style="{StaticResource RowTitle}" /><TextBlock Text="Native media, system, timer, and live-activity overlay." Style="{StaticResource RowDescription}" /></StackPanel><Button Grid.Column="1" Content="Recenter" Command="{Binding RecenterCommand}" Style="{StaticResource ActionButton}" /></Grid></Border>
                            <Border Style="{StaticResource LastPreferenceRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Reset everything" Style="{StaticResource RowTitle}" /><TextBlock Text="Restore all preferences to their defaults." Style="{StaticResource RowDescription}" /></StackPanel><Button Grid.Column="1" Content="Reset to defaults" Command="{Binding ResetCommand}" Style="{StaticResource ActionButton}" Foreground="#FF9F9F" /></Grid></Border>
                        </StackPanel></Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#11151B" BorderBrush="#303741" BorderThickness="0,1,0,0" Padding="24,11">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="#30D158" VerticalAlignment="Center" /><TextBlock Text="  Changes apply instantly and save when this window closes." FontSize="11.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" /></StackPanel>
                    <Button Grid.Column="1" Content="Done" Click="Done_Click" Background="{StaticResource Blue}" BorderBrush="{StaticResource Blue}" Style="{StaticResource ActionButton}" Padding="18,7" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
