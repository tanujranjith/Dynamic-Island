<UserControl x:Class="DynamicIsland.Windows.Views.TimerListPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TimerEditorResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer x:Name="EditorScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <TextBlock Text="{Binding StorageWarning}" Foreground="#FFB86C" TextWrapping="Wrap" Margin="0,4" />
            <Expander Visibility="{Binding HasMissedAlerts, Converter={StaticResource BoolToVisibility}}" Header="Missed alerts" Foreground="#CCD0D8" Margin="0,6">
                <StackPanel>
                    <TextBlock Text="{Binding MissedSummary}" TextWrapping="Wrap" />
                    <Button Content="Clear summary" Command="{Binding ClearMissedCommand}" Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>
            <Border Background="#16FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                <StackPanel>
                    <TextBlock Text="Timers" Foreground="White" FontSize="16" Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding Timers}" DisplayMemberPath="Text" SelectedValuePath="Id" SelectedValue="{Binding SelectedTimerId}" MinHeight="32" MaxDropDownHeight="220" AutomationProperties.Name="Selected timer" />
                    <Grid>
                        <TextBlock Text="Timer" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="{Binding TimerStateText}" HorizontalAlignment="Right" Foreground="#7EB8FF" />
                    </Grid>
                    <TextBlock Text="{Binding TimerRemaining}" FontFamily="Segoe UI Variable Display" FontSize="36" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,16,0,10" />
                    <ProgressBar Value="{Binding TimerProgress, Mode=OneWay}" Height="5" Foreground="#5AA7FF" Background="#24FFFFFF" BorderThickness="0" />
                    <WrapPanel HorizontalAlignment="Center" Margin="0,14,0,8">
                        <Button Content="5m" Command="{Binding StartPresetCommand}" CommandParameter="5" Style="{StaticResource SettingsButton}" Margin="3" Padding="12,7" />
                        <Button Content="10m" Command="{Binding StartPresetCommand}" CommandParameter="10" Style="{StaticResource SettingsButton}" Margin="3" Padding="12,7" />
                        <Button Content="15m" Command="{Binding StartPresetCommand}" CommandParameter="15" Style="{StaticResource SettingsButton}" Margin="3" Padding="12,7" />
                        <Button Content="25m" Command="{Binding StartPresetCommand}" CommandParameter="25" Style="{StaticResource SettingsButton}" Margin="3" Padding="12,7" />
                        <Button Content="30m" Command="{Binding StartPresetCommand}" CommandParameter="30" Style="{StaticResource SettingsButton}" Margin="3" Padding="12,7" />
                    </WrapPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding CustomMinutes}" Padding="8,7" ToolTip="Minutes" />
                        <TextBox Grid.Column="1" Text="{Binding TimerLabel}" Padding="8,7" Margin="8,0" ToolTip="Optional label" />
                        <Button Grid.Column="2" Content="Start" Command="{Binding StartCustomCommand}" Style="{StaticResource SettingsButton}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="{Binding TimerPrimaryText}" Command="{Binding TimerPrimaryCommand}" Style="{StaticResource SettingsButton}" Margin="4" />
                        <Button Content="Restart" Command="{Binding ResetTimerCommand}" Style="{StaticResource SettingsButton}" Background="#394252" Margin="4" />
                        <Button Content="Remove" Command="{Binding CancelTimerCommand}" Style="{StaticResource SettingsButton}" Background="#394252" Margin="4" />
                    </StackPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Save duration preset" Command="{Binding SavePresetCommand}" Style="{StaticResource SettingsButton}" Margin="3" />
                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Label" Width="150" Margin="3" AutomationProperties.Name="Saved timer presets" />
                        <Button Content="Start preset" Command="{Binding StartSavedPresetCommand}" Style="{StaticResource SettingsButton}" Margin="3" />
                        <Button Content="Delete preset" Command="{Binding DeletePresetCommand}" Style="{StaticResource SettingsButton}" Margin="3" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFB86C" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Background="#16FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,14,0,0" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                <StackPanel>
                    <TextBlock Text="Stopwatch" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="{Binding StopwatchText}" FontFamily="Segoe UI Variable Display" FontSize="34" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,14,0,10" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{Binding StopwatchPrimaryText}" Command="{Binding StopwatchPrimaryCommand}" Style="{StaticResource SettingsButton}" Margin="4" />
                        <Button Content="Lap" Command="{Binding StopwatchLapCommand}" Style="{StaticResource SettingsButton}" Background="#394252" Margin="4" />
                        <Button Content="Reset" Command="{Binding StopwatchResetCommand}" Style="{StaticResource SettingsButton}" Background="#394252" Margin="4" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Laps}" Margin="0,12,0,0" MaxHeight="140">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#C8D0DC" FontSize="12.5" Margin="2,2" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
