<UserControl x:Class="DynamicIsland.Windows.Views.StopwatchListPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TimerEditorResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <StackPanel Margin="4,0" HorizontalAlignment="Stretch">
            <Grid Width="286" Height="286" HorizontalAlignment="Center" Margin="0,4,0,12">
                <Ellipse Width="286" Height="286" Stroke="#FF1C3557" StrokeThickness="1" />
                <Ellipse Width="270" Height="270" Stroke="#FF263D61" StrokeThickness="8" />
                <Ellipse Width="270" Height="270" Stroke="#FF2AA8FF" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashArray="8,220">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" CenterX="135" CenterY="135" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock Text="{Binding StopwatchText}" FontFamily="Segoe UI Variable Display" FontSize="48" FontWeight="SemiBold"
                           Foreground="#FFF5F5F7" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                <Button Content="{Binding StopwatchPrimaryText}" Command="{Binding StopwatchPrimaryCommand}" Style="{StaticResource TimerPrimaryButton}" MinWidth="170" MinHeight="52" FontSize="15" Margin="5" />
                <Button Content="Reset" Command="{Binding StopwatchResetCommand}" Style="{StaticResource TimerSurfaceButton}" MinWidth="170" MinHeight="52" FontSize="15" Margin="5" />
            </WrapPanel>
            <Button Content="Lap" Command="{Binding StopwatchLapCommand}" Style="{StaticResource TimerSurfaceButton}" HorizontalAlignment="Center" MinWidth="110" Margin="5" />
            <ItemsControl ItemsSource="{Binding Laps}" Margin="0,10,0,0" MaxHeight="120">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#FFB7C7DF" FontSize="13" Margin="2,2" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
