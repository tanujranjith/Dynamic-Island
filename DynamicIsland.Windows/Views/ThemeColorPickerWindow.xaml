<Window x:Class="DynamicIsland.Windows.Views.ThemeColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom island color" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#10151D" Foreground="#EEF3FA" FontFamily="Segoe UI Variable Text" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,9" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Foreground" Value="#172033" /></Style>
        <Style TargetType="Slider"><Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="255" /><Setter Property="TickFrequency" Value="1" /><Setter Property="IsSnapToTickEnabled" Value="True" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock Text="Make it your color" FontSize="23" FontWeight="SemiBold" />
        <TextBlock Text="Choose a background. Text contrast adjusts automatically." TextWrapping="Wrap" Foreground="#ABB8C9" Margin="0,6,0,18" />
        <Border x:Name="ColorPreview" CornerRadius="18" Height="88" BorderThickness="1" BorderBrush="#64748B" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center" Margin="20,0"><TextBlock x:Name="PreviewTitle" Text="Q · Your custom island" FontWeight="SemiBold" FontSize="17" />
                <TextBlock x:Name="PreviewAnswer" Text="Gemini: answer      OAI: answer" Margin="0,5,0,0" /></StackPanel>
        </Border>
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
            <TextBlock Text="HEX color" VerticalAlignment="Center" />
            <TextBox x:Name="HexInput" Grid.Column="1" TextChanged="HexInput_Changed" Padding="10,7" MaxLength="7" AutomationProperties.Name="Hex background color" />
        </Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /></Grid.RowDefinitions>
            <TextBlock Text="R" VerticalAlignment="Center" /><Slider x:Name="Red" Grid.Column="1" ValueChanged="Slider_Changed" AutomationProperties.Name="Red" /><TextBlock x:Name="RedValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center" /><Slider x:Name="Green" Grid.Row="1" Grid.Column="1" ValueChanged="Slider_Changed" AutomationProperties.Name="Green" /><TextBlock x:Name="GreenValue" Grid.Row="1" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" /><Slider x:Name="Blue" Grid.Row="2" Grid.Column="1" ValueChanged="Slider_Changed" AutomationProperties.Name="Blue" /><TextBlock x:Name="BlueValue" Grid.Row="2" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <WrapPanel Margin="0,12,0,16">
            <Button Background="#241C3C" Width="36" Height="32" Tag="#241C3C" Click="Swatch_Click" ToolTip="Plum" AutomationProperties.Name="Plum" />
            <Button Background="#123D38" Width="36" Height="32" Tag="#123D38" Click="Swatch_Click" ToolTip="Forest" AutomationProperties.Name="Forest" />
            <Button Background="#182E51" Width="36" Height="32" Tag="#182E51" Click="Swatch_Click" ToolTip="Navy" AutomationProperties.Name="Navy" />
            <Button Background="#66384A" Width="36" Height="32" Tag="#66384A" Click="Swatch_Click" ToolTip="Rose" AutomationProperties.Name="Rose" />
            <Button Background="#F3D8B6" Width="36" Height="32" Tag="#F3D8B6" Click="Swatch_Click" ToolTip="Sand" AutomationProperties.Name="Sand" />
            <Button Background="#CADCEC" Width="36" Height="32" Tag="#CADCEC" Click="Swatch_Click" ToolTip="Ice" AutomationProperties.Name="Ice" />
        </WrapPanel>
        <Button x:Name="EyedropperButton" Content="Pick from screen…" Click="Eyedropper_Click" HorizontalAlignment="Left" />
        <TextBlock Text="Eyedropper: click a screen color. Esc or right-click cancels. Screen pixels stay local and are discarded after picking." TextWrapping="Wrap" Foreground="#ABB8C9" FontSize="12" Margin="0,8,0,12" />
        <TextBlock x:Name="ErrorText" Foreground="#FFABAB" TextWrapping="Wrap" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" />
            <Button x:Name="ApplyButton" Content="Use color" IsDefault="True" Click="Apply_Click" Background="#87BEFF" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
