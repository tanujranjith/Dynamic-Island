<Window x:Class="DynamicIsland.Windows.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DynamicIsland.Windows.Views"
        Title="Dynamic Island" Width="1200" Height="220"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="AppleBlack" Color="#FA000000" />
        <SolidColorBrush x:Key="AppleWhite" Color="#FFF5F5F7" />
        <SolidColorBrush x:Key="AppleSecondary" Color="#FF98989D" />
        <SolidColorBrush x:Key="AppleTrack" Color="#FF36363A" />
        <SolidColorBrush x:Key="AppleGreen" Color="#FF30D158" />

        <Style x:Key="AppleControl" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{Binding ShellControlBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                            <Border x:Name="Hover" CornerRadius="22" Background="{Binding ShellControlHoverBrush}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Activity tiles and timer panels deliberately stay dark in either app theme. -->
        <Style x:Key="AppleControlOnDark" TargetType="Button" BasedOn="{StaticResource AppleControl}">
            <Setter Property="Foreground" Value="{StaticResource AppleWhite}" />
        </Style>

        <Style x:Key="ApplePlayControl" TargetType="Button" BasedOn="{StaticResource AppleControl}">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="Background" Value="{StaticResource AppleWhite}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                            <Border x:Name="Chrome" CornerRadius="25" Background="{TemplateBinding Background}" />
                            <Border x:Name="Hover" CornerRadius="25" Background="#16000000" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Foreground" Value="{Binding ProgressFillBrush}" />
            <Setter Property="Background" Value="{Binding ProgressTrackBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="3" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatsButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AppleWhite}" />
            <Setter Property="Background" Value="#FF293444" />
            <Setter Property="BorderBrush" Value="#FF3B4A5F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#FF3A4C67" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.3" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatsPlayButton" TargetType="Button" BasedOn="{StaticResource StatsButton}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Background" Value="#FF315887" />
            <Setter Property="BorderBrush" Value="#FF4D7DB7" />
        </Style>

        <Style x:Key="TimerSurfaceButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFD7D7DC" />
            <Setter Property="Background" Value="#FF19191C" />
            <Setter Property="BorderBrush" Value="#FF343439" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#FF242429" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimerPrimaryButton" TargetType="Button" BasedOn="{StaticResource TimerSurfaceButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF287FF0" />
            <Setter Property="BorderBrush" Value="#FF4D9AFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="QButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="#FFE4E9F2" />
            <Setter Property="Background" Value="#FF151C27" />
            <Setter Property="BorderBrush" Value="#FF2B3749" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF202B3A" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF48698F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QActionButton" TargetType="Button" BasedOn="{StaticResource QButtonBase}">
            <Setter Property="Foreground" Value="#FFE2E6EF" />
            <Setter Property="Background" Value="#FF1B1F27" />
            <Setter Property="BorderBrush" Value="#FF303A48" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="QSelectorComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFE8EDF5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#FF223149" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FF173B65" /><Setter Property="Foreground" Value="White" /></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QSelectorComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFE8EDF5" />
            <Setter Property="Background" Value="#FF121923" />
            <Setter Property="BorderBrush" Value="#FF34445B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0,30,0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource QSelectorComboBoxItem}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="SelectorChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#FF91A0B5"
                                               Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="DropDownToggle" Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Margin="0,5,0,0" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}"
                                        MaxHeight="270" Background="#FF0D141F" BorderBrush="#FF34445B" BorderThickness="1" CornerRadius="12" Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectorChrome" Property="BorderBrush" Value="#FF5685B9" /><Setter TargetName="SelectorChrome" Property="Background" Value="#FF172131" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectorChrome" Property="BorderBrush" Value="#FF4D9AFF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SelectorChrome" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QResponseActionButton" TargetType="Button" BasedOn="{StaticResource QButtonBase}">
            <Setter Property="Foreground" Value="#FFC4CCDA" />
            <Setter Property="Background" Value="#FF131A24" />
            <Setter Property="BorderBrush" Value="#FF2A3546" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="QStopButton" TargetType="Button" BasedOn="{StaticResource QButtonBase}">
            <Setter Property="Foreground" Value="#FF8DC5FF" />
            <Setter Property="Background" Value="#FF101B2A" />
            <Setter Property="BorderBrush" Value="#FF2F8AF0" />
            <Setter Property="Padding" Value="15,7" />
            <Setter Property="MinHeight" Value="38" />
        </Style>

        <Style x:Key="QCircleButton" TargetType="Button" BasedOn="{StaticResource QButtonBase}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="QScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="38">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#FF56647A" CornerRadius="4" Margin="2,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QPrimaryButton" TargetType="Button" BasedOn="{StaticResource QButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF287FF0" />
            <Setter Property="BorderBrush" Value="#FF58A4FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="QSendButton" TargetType="Button" BasedOn="{StaticResource QPrimaryButton}">
            <Setter Property="Height" Value="58" />
            <Setter Property="MinWidth" Value="124" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="QMicButton" TargetType="Button" BasedOn="{StaticResource QButtonBase}">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="58" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="#FFF5F5F7" />
            <Setter Property="Background" Value="#FF1B1F27" />
        </Style>

        <Style x:Key="QComposerTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource AppleWhite}" />
            <Setter Property="Background" Value="#FF101722" />
            <Setter Property="BorderBrush" Value="#FF42516A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="CaretBrush" Value="#FF4D9AFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="ComposerChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ComposerChrome" Property="BorderBrush" Value="#FF4D9AFF" />
                                <Setter TargetName="ComposerChrome" Property="Background" Value="#FF121C2A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComposerChrome" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QModeButton" TargetType="Button" BasedOn="{StaticResource QButtonBase}">
            <Setter Property="Foreground" Value="#FFAEB8C8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="QAskModeButton" TargetType="Button" BasedOn="{StaticResource QModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding QIsAsk}" Value="True">
                    <Setter Property="Background" Value="#FF1D4A7A" />
                    <Setter Property="BorderBrush" Value="#FF4D9AFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="#FF74B4FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QSayModeButton" TargetType="Button" BasedOn="{StaticResource QModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding QIsSay}" Value="True">
                    <Setter Property="Background" Value="#FF1D4A7A" />
                    <Setter Property="BorderBrush" Value="#FF4D9AFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="#FF74B4FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimerTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource AppleWhite}" />
            <Setter Property="Background" Value="#FF151517" />
            <Setter Property="BorderBrush" Value="#FF343439" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="#FF409CFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TimerComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource AppleWhite}" />
            <Setter Property="Background" Value="#FF151517" />
            <Setter Property="BorderBrush" Value="#FF343439" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        </Style>

        <Storyboard x:Key="QThinkingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="QThinkingDot1" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.42" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="QThinkingDot2" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.42" BeginTime="0:0:0.12" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="QThinkingDot3" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.42" BeginTime="0:0:0.24" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="QThinkingGlow" Storyboard.TargetProperty="Opacity" From="0.18" To="0.7" Duration="0:0:0.8" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="QShimmer" Storyboard.TargetProperty="Opacity" From="0.15" To="0.7" Duration="0:0:0.8" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="QShimmerTransform" Storyboard.TargetProperty="X" From="-120" To="260" Duration="0:0:1.4" />
        </Storyboard>

        <Storyboard x:Key="NotifIntro">
            <DoubleAnimation Storyboard.TargetName="NotifScale" Storyboard.TargetProperty="ScaleX" From="0.92" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="NotifScale" Storyboard.TargetProperty="ScaleY" From="0.92" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="NotifBanner" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
            <DoubleAnimation Storyboard.TargetName="NotifBlur" Storyboard.TargetProperty="Radius" From="8" To="0" Duration="0:0:0.22" />
            <DoubleAnimation Storyboard.TargetName="NotifGlow" Storyboard.TargetProperty="BlurRadius" From="8" To="14" Duration="0:0:0.2" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="NotifSweepRect" Storyboard.TargetProperty="Opacity" From="0" To="0.6" Duration="0:0:0.12" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="NotifSweep" Storyboard.TargetProperty="X" From="-1" To="1" Duration="0:0:0.34" />
        </Storyboard>
    </Window.Resources>

    <Grid Background="{x:Null}">
        <Border x:Name="GlassShell" Width="230" Height="62" Margin="0,8,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="{Binding IslandCornerRadius}"
                Background="{Binding IslandSurfaceBrush}" BorderThickness="0"
                RenderTransformOrigin="0.5,0" ClipToBounds="True" Panel.ZIndex="10"
                MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave"
                MouseLeftButtonDown="Pill_MouseLeftButtonDown"
                MouseRightButtonUp="Pill_MouseRightButtonUp">
            <Border.RenderTransform><ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
            <Grid>
                <Border x:Name="BackgroundLayer" Background="{Binding IslandSurfaceBrush}" CornerRadius="{Binding IslandInnerCornerRadius}" IsHitTestVisible="False" />

                <!-- Compact: one calm, glanceable status strip — media, RAM, and time. -->
                <Grid x:Name="CompactContent" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="{Binding CompactAlbumSize}" Height="{Binding CompactAlbumSize}" VerticalAlignment="Center"
                          Visibility="{Binding ShowCompactArtSurface, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="{Binding CompactIconCorner}" Background="{Binding IslandCardBrush}">
                            <TextBlock Text="{Binding CompactGlyph}" FontFamily="Segoe Fluent Icons" FontSize="{Binding CompactGlyphFontSize}"
                                       Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="{Binding CompactIconCorner}" ClipToBounds="True"
                                Visibility="{Binding ShowCompactArt, Converter={StaticResource BoolToVisibility}}">
                            <Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" /></Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="11,0,13,0" VerticalAlignment="Center"
                                Visibility="{Binding ShowCompactMediaContent, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding MediaTitle}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding MediaTitleFontSize}" FontWeight="SemiBold"
                                   Foreground="{Binding PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MediaArtist}" Margin="0,2,0,0" FontFamily="{Binding UiFontFamily}" FontSize="{Binding MediaArtistFontSize}"
                                   Foreground="{Binding SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Grid Grid.Column="0" Width="{Binding CompactAlbumSize}" Height="{Binding CompactAlbumSize}" VerticalAlignment="Center"
                          Visibility="{Binding ShowCompactQContent, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="{Binding CompactIconCorner}" Background="#FF101B2B" BorderBrush="#FF245DA6" BorderThickness="1">
                            <TextBlock Text="Q" FontFamily="Segoe UI Variable Display" FontSize="20" FontWeight="SemiBold" Foreground="#FF5AA7FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="11,0,13,0" VerticalAlignment="Center"
                                Visibility="{Binding ShowCompactQContent, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding QCompactText}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactPrimaryFontSize}" FontWeight="SemiBold"
                                   Foreground="{Binding PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding QStatusText}" Margin="0,2,0,0" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactSecondaryFontSize}"
                                   Foreground="{Binding SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.ColumnSpan="3" Text="{Binding QCompactText}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactPrimaryFontSize}" FontWeight="SemiBold"
                               Foreground="{Binding PrimaryTextBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="8,0" Visibility="{Binding ShowCompactHolePunchQOutput, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding ShowCompactStatusContent, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="1" Height="30" Margin="0,0,12,0" Background="{Binding IslandDividerBrush}"
                                Visibility="{Binding ShowCompactRam, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Margin="0,0,13,0" Visibility="{Binding ShowCompactRam, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="RAM" FontFamily="{Binding UiFontFamily}" FontSize="8" Foreground="{Binding SecondaryTextBrush}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding RamText}" Margin="0,1,0,0" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactSecondaryFontSize}" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ClockTimeText}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactClockFontSize}" FontWeight="SemiBold"
                                       Visibility="{Binding ShowClock, Converter={StaticResource BoolToVisibility}}"
                                       Foreground="{Binding PrimaryTextBrush}" HorizontalAlignment="Right" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Right"
                                        Visibility="{Binding ShowBattery, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding BatteryGlyph}" FontFamily="Segoe Fluent Icons" FontSize="10"
                                           Foreground="{Binding SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding BatteryText}" Margin="4,0,0,0" FontFamily="{Binding UiFontFamily}" FontSize="9.5"
                                           Foreground="{Binding SecondaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="AirPodsCompactBanner" Grid.ColumnSpan="3" Padding="12,0"
                            Background="{Binding IslandSurfaceBrush}" BorderThickness="0" Panel.ZIndex="10"
                            Visibility="{Binding IsAirPodsBannerActive, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="AirPodsConnectionVisual" Width="50" Height="50" VerticalAlignment="Center" ClipToBounds="False">
                                <Image x:Name="AirPodsConnectionImage" Source="/DynamicIsland.Windows;component/Assets/airpods-pro.png"
                                       Width="50" Height="50" Stretch="Uniform" SnapsToDevicePixels="True"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="AirPodsImageScale" ScaleX="1" ScaleY="1" />
                                            <TranslateTransform x:Name="AirPodsImageTranslation" X="0" Y="0" />
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="AIRPODS CONNECTED" FontFamily="Segoe UI Variable Text" FontSize="8" FontWeight="SemiBold" Foreground="#FF9EE2AD" />
                                <TextBlock Text="{Binding AirPodsName}" Margin="0,1,0,0" FontFamily="Segoe UI Variable Text" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppleWhite}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" Fill="#FF30D158" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AirPodsCompactBatteryText}" FontFamily="Segoe UI Variable Text" FontSize="9" FontWeight="SemiBold"
                                           Foreground="#FF9EE2AD" TextTrimming="CharacterEllipsis" MaxWidth="142" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Stats-heavy compact mode: keep the glanceable lane, but expose the key status values. -->
                <Grid x:Name="StatsCompactContent" Margin="14,0" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding ShowMedia, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding CompactPrimaryText}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactPrimaryFontSize}"
                                   FontWeight="SemiBold" Foreground="{Binding PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CompactSecondaryText}" Margin="0,2,0,0" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactSecondaryFontSize}"
                                   Foreground="{Binding SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="1" Height="30" Margin="10,0" Background="{Binding IslandDividerBrush}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ClockTimeText}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding CompactClockFontSize}"
                                   FontWeight="SemiBold" Foreground="{Binding PrimaryTextBrush}" HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding ShowBattery, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding BatteryGlyph}" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{Binding SecondaryTextBrush}" />
                            <TextBlock Text="{Binding BatteryText}" Margin="4,1,0,0" FontFamily="{Binding UiFontFamily}" FontSize="9.5" Foreground="{Binding SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Expanded: one focused now-playing card. -->
                <ScrollViewer x:Name="ExpandedViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" CanContentScroll="False"><Grid x:Name="ExpandedContent" Margin="28,22" Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="50" />
                        <!-- The active deck sizes to its content: Apple cards stay compact while
                             the Stats dashboard gets enough height for all three status tiles. -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.RowSpan="3" Width="{Binding ExpandedAlbumSize}" Height="{Binding ExpandedAlbumSize}" Margin="0,0,16,0" VerticalAlignment="Top" Cursor="Hand" MouseLeftButtonUp="AlbumArt_Click">
                        <Border CornerRadius="{Binding ExpandedIconCorner}" Background="{Binding IslandCardBrush}">
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="34"
                                       Foreground="{Binding SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="{Binding ExpandedIconCorner}" ClipToBounds="True"
                                Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}">
                            <Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" /></Border.Background>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Grid.ColumnSpan="2">
                            <TextBlock Text="{Binding MediaTitle}" MaxWidth="330" TextTrimming="CharacterEllipsis"
                                       FontFamily="{Binding UiFontFamily}" FontSize="{Binding ExpandedMediaTitleFontSize}" FontWeight="SemiBold"
                                       Foreground="{Binding PrimaryTextBrush}" />
                            <TextBlock Text="{Binding MediaArtist}" Margin="0,3,0,0" MaxWidth="340"
                                       TextTrimming="CharacterEllipsis" FontFamily="{Binding UiFontFamily}" FontSize="{Binding ExpandedMediaArtistFontSize}"
                                       Foreground="{Binding SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Height="34" VerticalAlignment="Center"
                                    HorizontalAlignment="Right" Margin="4,0,0,0" Visibility="{Binding ShowMusicVisualizer, Converter={StaticResource BoolToVisibility}}">
                            <Rectangle Width="4" Height="{Binding VisualizerBar0Height}" RadiusX="2" RadiusY="2" Fill="{Binding AccentBrush}" VerticalAlignment="Bottom" Margin="1,0" />
                            <Rectangle Width="4" Height="{Binding VisualizerBar1Height}" RadiusX="2" RadiusY="2" Fill="{Binding AccentBrush}" VerticalAlignment="Bottom" Margin="1,0" />
                            <Rectangle Width="4" Height="{Binding VisualizerBar2Height}" RadiusX="2" RadiusY="2" Fill="{Binding AccentBrush}" VerticalAlignment="Bottom" Margin="1,0" />
                            <Rectangle Width="4" Height="{Binding VisualizerBar3Height}" RadiusX="2" RadiusY="2" Fill="{Binding AccentBrush}" VerticalAlignment="Bottom" Margin="1,0" />
                            <Rectangle Width="4" Height="{Binding VisualizerBar4Height}" RadiusX="2" RadiusY="2" Fill="{Binding AccentBrush}" VerticalAlignment="Bottom" Margin="1,0" />
                            <Rectangle Width="4" Height="{Binding VisualizerBar5Height}" RadiusX="2" RadiusY="2" Fill="{Binding AccentBrush}" VerticalAlignment="Bottom" Margin="1,0" />
                            <Rectangle Width="4" Height="{Binding VisualizerBar6Height}" RadiusX="2" RadiusY="2" Fill="{Binding AccentBrush}" VerticalAlignment="Bottom" Margin="1,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="2" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Q" Click="QButton_Click" Style="{StaticResource AppleControl}" Width="34" Height="34" FontSize="13" FontFamily="Segoe UI Variable Text"
                                    Foreground="#FF409CFF" ToolTip="Ask Q" AutomationProperties.Name="Open Q" />
                            <Button Content="&#xE916;" Click="TimerButton_Click" Style="{StaticResource AppleControl}"
                                    Width="34" Height="34" FontSize="14" ToolTip="Timer"
                                    AutomationProperties.Name="Open timer" />
                            <Button Content="&#xE713;" Click="SettingsButton_Click" Style="{StaticResource AppleControl}"
                                    Width="34" Height="34" FontSize="14" ToolTip="Settings"
                                    AutomationProperties.Name="Open settings" />
                            <Button Content="{Binding VolumeGlyph}" Command="{Binding ToggleMuteCommand}" Style="{StaticResource AppleControl}"
                                    Visibility="{Binding ShowVolume, Converter={StaticResource BoolToVisibility}}"
                                    Width="34" Height="34" FontSize="14" ToolTip="Mute" />
                            <Button x:Name="OutputDeviceButton" Content="&#xE711;" Style="{StaticResource AppleControl}" Width="34" Height="34" FontSize="14"
                                    Visibility="{Binding ShowVolume, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Choose audio output" MouseLeftButtonUp="OutputDevice_Click" />
                            <Button x:Name="MenuButton" Content="&#xE712;" Style="{StaticResource AppleControl}" Width="34" Height="34" FontSize="14"
                                    ToolTip="More" Click="MenuButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom" PlacementTarget="{Binding ElementName=MenuButton}" HorizontalOffset="-126" VerticalOffset="6"><MenuItem Header="{Binding ActivityPinText}" IsEnabled="False" />
<MenuItem Header="Pin media" Command="{Binding PinMediaCommand}" />
<MenuItem Header="Pin selected timer" Command="{Binding PinTimerCommand}" />
<MenuItem Header="Automatic activity" Command="{Binding UnpinActivityCommand}" />
<Separator />
                                        <MenuItem Header="Settings" Click="SettingsButton_Click" />
                                        <MenuItem Header="Ask Q" Click="QButton_Click" />
                                        <MenuItem Header="Timer" Click="TimerButton_Click" />
                                        <Separator />
                                        <MenuItem Header="Recenter island" Click="RecenterMenu_Click" />
                                        <MenuItem Header="Collapse" Click="CollapseMenu_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>

                        <!-- Expanded privacy state behaves like a compact Live Activity region rather
                             than a floating indicator or notification card. Row 2 names the app(s)
                             holding the sensor so users can see *where* it is being used. -->
                        <Border x:Name="ExpandedPrivacyActivity" Grid.Row="1" Height="Auto" MinHeight="26" MinWidth="168" MaxWidth="340"
                                Padding="10,5" Margin="0,3,0,1" HorizontalAlignment="Right"
                                CornerRadius="13" Background="#FF111411" BorderBrush="#24FFFFFF" BorderThickness="1"
                                RenderTransformOrigin="1,0.5" IsHitTestVisible="False"
                                ToolTip="{Binding PrivacyDetailText}"
                                AutomationProperties.Name="{Binding PrivacyDetailText}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowPrivacyInUse}" Value="True" />
                                                <Condition Binding="{Binding IsExpanded}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ExpandedPrivacyScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="ExpandedPrivacyTranslate" X="0" Y="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0"
                                         Fill="{Binding PrivacyIndicatorBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding PrivacyActivityText}"
                                           FontFamily="Segoe UI Variable Text" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppleWhite}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="LIVE" Margin="10,0,0,0"
                                           FontFamily="Segoe UI Variable Text" FontSize="8" FontWeight="Bold"
                                           Foreground="{Binding PrivacyIndicatorBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PrivacySourceText}"
                                           Margin="0,1,0,0" MaxWidth="280" TextTrimming="CharacterEllipsis"
                                           FontFamily="Segoe UI Variable Text" FontSize="10" FontWeight="Normal"
                                           Foreground="{StaticResource AppleSecondary}" VerticalAlignment="Center"
                                           Visibility="{Binding HasPrivacySource, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                          Visibility="{Binding ShowMediaTimes, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding MediaElapsedText}" Width="34" FontFamily="Segoe UI Variable Text" FontSize="10"
                                   Foreground="{Binding SecondaryTextBrush}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Padding="0,8" Cursor="Hand"
                                MouseLeftButtonDown="ProgressBar_SeekStart"
                                MouseMove="ProgressBar_SeekMove"
                                MouseLeftButtonUp="ProgressBar_SeekEnd"
                                LostMouseCapture="ProgressBar_SeekCancel">
                            <ProgressBar Value="{Binding MediaProgress, Mode=OneWay}" Style="{StaticResource AppleProgress}" IsHitTestVisible="False" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding MediaTrailingTimeText}" Width="38" TextAlignment="Right"
                                   FontFamily="Segoe UI Variable Text" FontSize="10" Foreground="{Binding SecondaryTextBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <Button Content="&#xE892;" Command="{Binding PreviousCommand}" Style="{StaticResource AppleControl}" AutomationProperties.Name="Previous track" />
                        <Button Content="−10" Command="{Binding SeekBackCommand}" Style="{StaticResource AppleControl}" Margin="8,0,0,0"
                                FontFamily="Segoe UI Variable Text" FontSize="11" FontWeight="SemiBold" ToolTip="Back 10 seconds" AutomationProperties.Name="Back 10 seconds" />
                        <Button Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" Style="{StaticResource ApplePlayControl}" Margin="14,0" AutomationProperties.Name="Play or pause" />
                        <Button Content="30+" Command="{Binding SeekForwardCommand}" Style="{StaticResource AppleControl}" Margin="0,0,8,0"
                                FontFamily="Segoe UI Variable Text" FontSize="11" FontWeight="SemiBold" ToolTip="Forward 30 seconds" AutomationProperties.Name="Forward 30 seconds" />
                        <Button Content="&#xE893;" Command="{Binding NextCommand}" Style="{StaticResource AppleControl}" AutomationProperties.Name="Next track" />
                    </StackPanel>

                    <!-- A calm live-activity deck: each subject gets its own small, coherent Apple-like zone. -->
                    <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" MinHeight="78">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="142" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="126" />
                            </Grid.ColumnDefinitions>

                            <Border CornerRadius="16" Background="#FF151517" Padding="12,9"
                                    Visibility="{Binding ShowVolume, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Text="VOLUME" FontFamily="Segoe UI Variable Text" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AppleSecondary}" />
                                    <Grid Grid.Row="1" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button Content="{Binding VolumeGlyph}" Command="{Binding ToggleMuteCommand}" Style="{StaticResource AppleControlOnDark}"
                                                Width="24" Height="24" Margin="0,0,5,0" FontSize="11" ToolTip="Mute" />
                                        <TextBlock Grid.Column="1" Text="{Binding VolumeText}" FontFamily="Segoe UI Variable Text" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppleWhite}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="&#xE738;" Command="{Binding AdjustVolumeCommand}" CommandParameter="-2" Style="{StaticResource AppleControlOnDark}" Width="22" Height="22" Margin="0" FontSize="9" ToolTip="Volume down" />
                                            <Button Content="&#xE710;" Command="{Binding AdjustVolumeCommand}" CommandParameter="2" Style="{StaticResource AppleControlOnDark}" Width="22" Height="22" Margin="2,0,0,0" FontSize="9" ToolTip="Volume up" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" CornerRadius="16" Background="#FF151517" Padding="12,9"
                                    Visibility="{Binding ShowSystemMonitor, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM" FontFamily="Segoe UI Variable Text" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AppleSecondary}" />
                                    <Grid Margin="0,5,0,0" Height="32">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="MEMORY" FontFamily="Segoe UI Variable Text" FontSize="9" Foreground="{StaticResource AppleSecondary}" />
                                                    <TextBlock Text="{Binding RamText}" FontFamily="Segoe UI Variable Text" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" />
                                                </StackPanel>
                                                <Grid x:Name="RamUsageTrack" Grid.Column="1" Height="22" VerticalAlignment="Bottom" ClipToBounds="True">
                                                    <Border Height="4" CornerRadius="2" Background="#FF303035" VerticalAlignment="Bottom" />
                                                    <Border Height="4" CornerRadius="2" Background="#FFF5F5F7" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource PercentageWidth}">
                                                                <Binding Path="RamPercentValue" />
                                                                <Binding Path="ActualWidth" ElementName="RamUsageTrack" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="NETWORK" FontFamily="Segoe UI Variable Text" FontSize="9" Foreground="{StaticResource AppleSecondary}" />
                                                    <TextBlock Text="{Binding NetText}" TextTrimming="CharacterEllipsis" FontFamily="Segoe UI Variable Text" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" />
                                                </StackPanel>
                                                <Grid Grid.Column="1" Height="22" VerticalAlignment="Bottom" ClipToBounds="True">
                                                    <Polyline Points="{Binding NetSparkline}" Stroke="#FFF5F5F7" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" CornerRadius="16" Background="#FF151517" Padding="12,9"
                                    Visibility="{Binding ShowClock, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding ClockText}" FontFamily="Segoe UI Variable Text" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" VerticalAlignment="Center" />
                                    <Grid Grid.Row="1">
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCharging, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="&#xE83E;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{StaticResource AppleGreen}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ChargingText}" Margin="4,0,7,0" FontFamily="Segoe UI Variable Text" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AppleGreen}" />
                                            <TextBlock Text="{Binding DateText}" FontFamily="Segoe UI Variable Text" FontSize="9.5" Foreground="{StaticResource AppleSecondary}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding ShowDate, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowBatteryLevel, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding BatteryGlyph}" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{StaticResource AppleSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding BatteryText}" Margin="4,0,7,0" FontFamily="Segoe UI Variable Text" FontSize="9.5" Foreground="{StaticResource AppleSecondary}" />
                                            <TextBlock Text="{Binding DateText}" FontFamily="Segoe UI Variable Text" FontSize="9.5" Foreground="{StaticResource AppleSecondary}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding ShowDate, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                    </Grid>

                    </Grid>

                    <!-- Accessories share one horizontal lane while remaining distinct cards. -->
                    <DockPanel x:Name="AccessoryLane" SizeChanged="AccessoryLane_SizeChanged" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" LastChildFill="True">
                        <Border x:Name="LiveWidgetsStrip" DockPanel.Dock="Right"
                                Width="{Binding LiveWidgetRailWidth}" Height="64"
                                Margin="{Binding LiveWidgetRailMargin}" CornerRadius="16" Background="Transparent"
                                Visibility="{Binding ShowWidgetsPanel, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                            <ScrollViewer x:Name="LiveWidgetsScroller"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                          PanningMode="HorizontalOnly" CanContentScroll="False"
                                          PreviewMouseWheel="LiveWidgetsScroller_PreviewMouseWheel"
                                          ScrollChanged="LiveWidgetsScroller_ScrollChanged" PreviewKeyDown="LiveWidgetsScroller_PreviewKeyDown" GotKeyboardFocus="LiveWidgetsScroller_GotKeyboardFocus">
                                <StackPanel Orientation="Horizontal">
                            <Border Width="{Binding SmallLiveWidgetWidth}" Height="64" Margin="0,0,8,0" Padding="10,5" CornerRadius="16"
                                    Background="#FF1A2028" Visibility="{Binding ShowConnectivity, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Button Command="{Binding OpenWifiSettingsCommand}" Background="Transparent" BorderThickness="0" Padding="0"
                                            ToolTip="Open Wi-Fi settings" AutomationProperties.Name="Open Wi-Fi settings">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE701;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="{Binding WifiStatusBrush}" VerticalAlignment="Center" />
                                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="WI-FI" FontSize="8" Foreground="#FF8F9BA8" /><TextBlock Text="{Binding WifiStatusText}" FontSize="10.5" Foreground="{StaticResource AppleWhite}" /></StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="1" Command="{Binding OpenBluetoothSettingsCommand}" Background="Transparent" BorderThickness="0" Padding="0"
                                            ToolTip="Open Bluetooth settings" AutomationProperties.Name="Open Bluetooth settings">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE702;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="{Binding BluetoothStatusBrush}" VerticalAlignment="Center" />
                                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="BLUETOOTH" FontSize="8" Foreground="#FF8F9BA8" /><TextBlock Text="{Binding BluetoothStatusText}" FontSize="10.5" Foreground="{StaticResource AppleWhite}" /></StackPanel>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <Border Width="{Binding WeatherWidgetWidth}" Height="64" Margin="0,0,8,0" Padding="11,7" CornerRadius="16"
                                    Background="#FF1A2028"
                                    Visibility="{Binding ShowWeather, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding WeatherGlyph}" FontFamily="Segoe Fluent Icons" FontSize="24"
                                               Foreground="#FF64B5FF" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="WEATHER" FontFamily="Segoe UI Variable Text" FontSize="8"
                                                   FontWeight="SemiBold" Foreground="#FF8F9BA8" />
                                        <TextBlock Text="{Binding WeatherTempText}" Margin="0,2,0,0"
                                                   FontFamily="Segoe UI Variable Text" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppleWhite}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding WeatherDescText}" Margin="0,1,0,0"
                                                   FontFamily="Segoe UI Variable Text" FontSize="9.5"
                                                   Foreground="{StaticResource AppleSecondary}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Width="{Binding CountdownWidgetWidth}" Height="64" Margin="0,0,8,0" Padding="11,7" CornerRadius="16"
                                    Background="#FF1A2028"
                                    Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="COUNTDOWN" FontFamily="Segoe UI Variable Text" FontSize="8"
                                               FontWeight="SemiBold" Foreground="#FF8F9BA8" />
                                    <TextBlock Text="{Binding CountdownText}" Margin="0,5,0,0"
                                               FontFamily="Segoe UI Variable Text" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource AppleWhite}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <Border Width="{Binding MeetingWidgetWidth}" Height="64" Margin="0,0,8,0" Padding="11,7" CornerRadius="16"
                                    Background="#FF1A2028"
                                    Visibility="{Binding ShowNextMeeting, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="NEXT MEETING" FontFamily="Segoe UI Variable Text" FontSize="8"
                                                   FontWeight="SemiBold" Foreground="#FF8F9BA8" />
                                        <TextBlock Text="{Binding MeetingTitle}" Margin="0,3,0,0"
                                                   FontFamily="Segoe UI Variable Text" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppleWhite}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MeetingWhen}" Margin="0,1,0,0"
                                                   FontFamily="Segoe UI Variable Text" FontSize="9.5"
                                                   Foreground="{StaticResource AppleSecondary}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Join" Margin="8,0,0,0" Padding="10,6"
                                            Style="{StaticResource TimerPrimaryButton}" Click="JoinMeeting_Click"
                                            Visibility="{Binding HasMeetingJoin, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="Join next meeting" />
                                </Grid>
                            </Border>

                            <Border Width="{Binding BatteryTimeWidgetWidth}" Height="64" Margin="0,0,8,0" Padding="11,7" CornerRadius="16"
                                    Background="#FF1A2028"
                                    Visibility="{Binding ShowBatteryTime, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="BATTERY TIME" FontFamily="Segoe UI Variable Text" FontSize="8"
                                               FontWeight="SemiBold" Foreground="#FF8F9BA8" />
                                    <TextBlock Text="{Binding BatteryTimeText}" Margin="0,5,0,0"
                                               FontFamily="Segoe UI Variable Text" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource AppleWhite}" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding WorldClocks}"
                                          Visibility="{Binding ShowWorldClocks, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding DataContext.SmallLiveWidgetWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="64" Margin="0,0,8,0" Padding="11,7" CornerRadius="16" Background="#FF1A2028">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontFamily="Segoe UI Variable Text" FontSize="8"
                                                           FontWeight="SemiBold" Foreground="#FF8F9BA8" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Time}" Margin="0,5,0,0" FontFamily="Segoe UI Variable Text"
                                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Stocks}"
                                          Visibility="{Binding ShowStocks, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding DataContext.SmallLiveWidgetWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="64" Margin="0,0,8,0" Padding="11,7" CornerRadius="16" Background="#FF1A2028">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Symbol}" FontFamily="Segoe UI Variable Text" FontSize="8"
                                                               FontWeight="SemiBold" Foreground="#FF8F9BA8" />
                                                    <TextBlock Text="{Binding PriceText}" Margin="0,5,0,0" FontFamily="Segoe UI Variable Text"
                                                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding ChangeText}" Margin="8,0,0,0"
                                                           FontFamily="Segoe UI Variable Text" FontSize="9.5"
                                                           Foreground="#FF74D990" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                                <!-- Overflow affordance: edge fade + chevron appear only while content
                                     is clipped off-screen (toggled in code-behind on ScrollChanged). -->
                                <Border x:Name="LiveWidgetsFade" Width="30" HorizontalAlignment="Right"
                                        CornerRadius="0,16,16,0" IsHitTestVisible="False" Visibility="Collapsed">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#001A2028" />
                                            <GradientStop Offset="1" Color="#FF1A2028" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Button x:Name="LiveWidgetsPreviousButton" Content="&#xE76B;" Style="{StaticResource AppleControlOnDark}" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" Click="LiveWidgetsPreviousButton_Click" ToolTip="Previous widgets" AutomationProperties.Name="Previous widgets" />
                                <Button x:Name="LiveWidgetsMoreButton" Content="&#xE76C;"
                                        Style="{StaticResource AppleControlOnDark}" Width="22" Height="22"
                                        FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,4,0" Visibility="Collapsed"
                                        ToolTip="More widgets" AutomationProperties.Name="Scroll widgets right"
                                        Click="LiveWidgetsMoreButton_Click" />
                            </Grid>
                        </Border>

                        <!-- AirPods remains its own card and fills the space left of live widgets. -->
                        <Border x:Name="AirPodsCard" MinHeight="64" Margin="0,8,0,0" Padding="12,7" CornerRadius="16"
                                Background="#FF17191D" BorderBrush="#24FFFFFF" BorderThickness="1"
                                Visibility="{Binding ShowAirPodsCard, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="12" Background="#FF242A31" VerticalAlignment="Center">
                                    <Image Source="/DynamicIsland.Windows;component/Assets/airpods-pro.png"
                                           Width="38" Height="38" Stretch="Uniform" SnapsToDevicePixels="True" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="AIRPODS" FontFamily="Segoe UI Variable Text" FontSize="8" FontWeight="SemiBold" Foreground="#FF8F9BA8" />
                                    <TextBlock Text="{Binding AirPodsName}" Margin="0,2,0,0" FontFamily="Segoe UI Variable Text" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource AppleWhite}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding AirPodsStatusText}" Margin="0,1,0,0" FontFamily="Segoe UI Variable Text" FontSize="9" Foreground="#FF9BA8B5" />
                                </StackPanel>
                                <Border Grid.Column="2" Padding="9,5" CornerRadius="12" Background="#142D21" BorderBrush="#344D3D" BorderThickness="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="#FF30D158" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding AirPodsBatterySummary}" FontFamily="Segoe UI Variable Text" FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="#FF9EE2AD" TextTrimming="CharacterEllipsis" MaxWidth="135" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DockPanel>

                    <!-- Stats has a complete, opaque dashboard instead of sitting on top of the
                         Apple media deck. That prevents duplicate artwork/title rows and lets the
                         three live tiles use the full available height. -->
                    <Border x:Name="StatsOverlay" Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Grid.ColumnSpan="3" Padding="18,14"
                            CornerRadius="22" Background="#FF101722" Opacity="0" IsHitTestVisible="False"
                            Visibility="Collapsed" Panel.ZIndex="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="124" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="164" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="LIVE STATS" FontFamily="Segoe UI Variable Text" FontSize="9" FontWeight="SemiBold" Foreground="#FF64D2FF" />
                                <TextBlock Text="  •  NOW PLAYING" FontFamily="Segoe UI Variable Text" FontSize="9" Foreground="#FF8A98AA" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="&#xE916;" Click="TimerButton_Click" Style="{StaticResource AppleControlOnDark}" Width="30" Height="30" FontSize="13" ToolTip="Timer" />
                                <Button Content="&#xE713;" Click="SettingsButton_Click" Style="{StaticResource AppleControlOnDark}" Width="30" Height="30" FontSize="13" ToolTip="Settings" />
                                <Button Content="{Binding VolumeGlyph}" Command="{Binding ToggleMuteCommand}" Style="{StaticResource AppleControlOnDark}" Width="30" Height="30" FontSize="13" ToolTip="Mute" />
                            </StackPanel>

                            <Border Grid.Row="1" Width="104" Height="104" CornerRadius="18" Background="#FF202A39" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="#FF9FB2C9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border CornerRadius="18" ClipToBounds="True" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}">
                                        <Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" /></Border.Background>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MediaTitle}" FontFamily="Segoe UI Variable Text" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MediaArtist}" Margin="0,2,0,8" FontFamily="Segoe UI Variable Text" FontSize="12" Foreground="{StaticResource AppleSecondary}" TextTrimming="CharacterEllipsis" />
                                <Grid Height="5" Margin="0,0,0,10">
                                    <ProgressBar Value="{Binding MediaProgress, Mode=OneWay}" Style="{StaticResource AppleProgress}"
                                                 Foreground="{StaticResource AppleWhite}" Background="#FF303035" />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="&#xE892;" Command="{Binding PreviousCommand}" Style="{StaticResource StatsButton}" ToolTip="Previous track" />
                                    <Button Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" Style="{StaticResource StatsPlayButton}" ToolTip="Play or pause" />
                                    <Button Content="&#xE893;" Command="{Binding NextCommand}" Style="{StaticResource StatsButton}" ToolTip="Next track" />
                                    <TextBlock Text="{Binding MediaElapsedText}" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text" FontSize="10" Foreground="{StaticResource AppleSecondary}" />
                                    <TextBlock Text="{Binding MediaTrailingTimeText}" Margin="7,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text" FontSize="10" Foreground="{StaticResource AppleSecondary}" />
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Row="1" Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border CornerRadius="13" Background="#FF1A2533" Padding="11,7" Margin="0,0,0,5">
                                    <Grid><TextBlock Text="MEMORY" FontFamily="Segoe UI Variable Text" FontSize="8" Foreground="#FF8A98AA" /><TextBlock Text="{Binding RamText}" Margin="0,13,0,0" FontFamily="Segoe UI Variable Text" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" /></Grid>
                                </Border>
                                <Border Grid.Row="1" CornerRadius="13" Background="#FF1A2533" Padding="11,7" Margin="0,0,0,5">
                                    <Grid><TextBlock Text="NETWORK" FontFamily="Segoe UI Variable Text" FontSize="8" Foreground="#FF8A98AA" /><TextBlock Text="{Binding NetText}" Margin="0,13,0,0" FontFamily="Segoe UI Variable Text" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" TextTrimming="CharacterEllipsis" /></Grid>
                                </Border>
                                <Border Grid.Row="2" CornerRadius="13" Background="#FF1A2533" Padding="11,7">
                                    <Grid><TextBlock Text="POWER" FontFamily="Segoe UI Variable Text" FontSize="8" Foreground="#FF8A98AA" /><TextBlock Text="{Binding BatteryText}" Margin="0,13,0,0" FontFamily="Segoe UI Variable Text" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" /></Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Active timer live activity: it shares the expanded island and appears directly
                         beneath the existing volume/system/time deck in either visual style. -->
                    <Border x:Name="LiveTimerStrip" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                            Height="76" Margin="0,10,0,0" Padding="14,10" CornerRadius="17"
                            Background="#FF151517" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>

                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons" FontSize="26"
                                           Foreground="#FF409CFF" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="TIMER" FontFamily="Segoe UI Variable Text" FontSize="9"
                                               FontWeight="SemiBold" Foreground="#FF409CFF" />
                                    <TextBlock Text="{Binding LiveTimerLabel}" Margin="0,3,0,0"
                                               FontFamily="Segoe UI Variable Text" FontSize="11"
                                               Foreground="{StaticResource AppleSecondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Column="1" Margin="16,0,18,0" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding TimerRemaining}" FontFamily="Segoe UI Variable Display"
                                           FontSize="29" FontWeight="Light" Foreground="{StaticResource AppleWhite}"
                                           HorizontalAlignment="Center" />
                                <ProgressBar Grid.Row="1" Value="{Binding TimerProgress, Mode=OneWay}"
                                             Height="4" Margin="0,5,0,0" Foreground="#FF409CFF"
                                             Background="#FF303035" Style="{StaticResource AppleProgress}" />
                            </Grid>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="{Binding LiveTimerPrimaryGlyph}" Command="{Binding TimerPrimaryCommand}"
                                        Style="{StaticResource ApplePlayControl}" Width="46" Height="46" Margin="0,0,8,0"
                                        FontSize="17" ToolTip="{Binding LiveTimerPrimaryTooltip}"
                                        AutomationProperties.Name="{Binding LiveTimerPrimaryTooltip}" />
                                <Button Content="&#xE711;" Command="{Binding CancelTimerCommand}"
                                        Style="{StaticResource AppleControlOnDark}" Width="38" Height="38" Margin="0"
                                        FontSize="14" ToolTip="Cancel timer" AutomationProperties.Name="Cancel timer" />
                            </StackPanel>
                        </Grid>
                    </Border>

                <!-- Q overlay: approved Apple-inspired conversation mockup. -->
                <Grid x:Name="QContent" Grid.Row="0" Grid.Column="0" Grid.RowSpan="7" Grid.ColumnSpan="3"
                      Panel.ZIndex="90" Margin="0" Background="Transparent" ClipToBounds="False" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                    <Border x:Name="QShell" CornerRadius="{Binding IslandCornerRadius}" Background="#FF080C12"
                            BorderBrush="#FF344156" BorderThickness="1" ClipToBounds="True">
                        <Grid Margin="30,20,30,22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="72" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="104" />
                                <RowDefinition Height="58" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="58" Height="58" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="18"
                                        Background="#FF1478F2" BorderBrush="#FF54A5FF" BorderThickness="1">
                                    <TextBlock Text="Q" FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,2,0,0" VerticalAlignment="Top">
                                    <TextBlock Text="Q · VISUAL ASSISTANT" FontFamily="Segoe UI Variable Display" FontSize="19"
                                               FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Border Background="#FF151D29" BorderBrush="#FF344258" BorderThickness="1" CornerRadius="12" Padding="9,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#FF69AFFF" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding QSourceText}" Margin="6,0,0,0" FontFamily="Segoe UI Variable Text" FontSize="11.5"
                                                           Foreground="#FFD7DEE9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Ellipse Width="8" Height="8" Margin="14,0,8,0" Fill="#FF4D9AFF" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding QHeaderStatusText}" FontFamily="Segoe UI Variable Text" FontSize="12.5"
                                                   Foreground="#FF66AAFF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="&#xE916;" Click="TimerButton_Click" Style="{StaticResource AppleControlOnDark}" Width="38" Height="38" FontSize="15" ToolTip="Timer" AutomationProperties.Name="Open timer" />
                                    <Button Content="&#xE713;" Click="SettingsButton_Click" Style="{StaticResource AppleControlOnDark}" Width="38" Height="38" FontSize="15" ToolTip="Settings" AutomationProperties.Name="Open settings" />
                                    <Button Content="{Binding VolumeGlyph}" Command="{Binding ToggleMuteCommand}" Style="{StaticResource AppleControlOnDark}" Width="38" Height="38" FontSize="15" ToolTip="Mute" AutomationProperties.Name="Toggle mute" />
                                    <Button Content="&#xE8BB;" Click="QClose_Click" Style="{StaticResource AppleControlOnDark}" Width="38" Height="38" FontSize="15" ToolTip="Close Q" AutomationProperties.Name="Close Q" />
                                    <Button x:Name="QMenuButton" Content="&#xE712;" Click="MenuButton_Click" Style="{StaticResource AppleControlOnDark}" Width="38" Height="38" FontSize="15" ToolTip="More" AutomationProperties.Name="More options">
                                        <Button.ContextMenu>
                                            <ContextMenu Placement="Bottom" PlacementTarget="{Binding ElementName=QMenuButton}" HorizontalOffset="-126" VerticalOffset="6">
                                                <MenuItem Header="Settings" Click="SettingsButton_Click" />
                                                <MenuItem Header="Timer" Click="TimerButton_Click" />
                                                <Separator />
                                                <MenuItem Header="Recenter island" Click="RecenterMenu_Click" />
                                                <MenuItem Header="Close Q" Click="QClose_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,12,0,10">
                                <ScrollViewer x:Name="QTranscriptScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="False" ScrollChanged="QTranscriptScroll_ScrollChanged" Padding="0,0,8,0">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource QScrollBar}" />
                                    </ScrollViewer.Resources>
                                    <StackPanel>
                                        <Border Margin="0,0,0,12" Padding="16,12" Background="#FF132237" BorderBrush="#FF2C5C91" BorderThickness="1" CornerRadius="16"
                                                Visibility="{Binding QNeedsConsent, Converter={StaticResource BoolToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Share this window with Q?" FontFamily="Segoe UI Variable Text" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" />
                                                    <TextBlock Text="Q sends the active window’s text and, when supported, image to your selected provider."
                                                               Margin="0,4,12,0" FontFamily="Segoe UI Variable Text" FontSize="11.5" Foreground="#FFAEBBCD" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Allow" Click="QAllow_Click" Style="{StaticResource QPrimaryButton}" Padding="16,7" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <Border Margin="0,0,0,14" Padding="20,14" MinHeight="78" Background="#FF111824" BorderBrush="#FF29364A"
                                                BorderThickness="1" CornerRadius="18" Visibility="{Binding QHasPrompt, Converter={StaticResource BoolToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="19" Background="#FF202B3D">
                                                    <TextBlock Text="You" FontFamily="Segoe UI Variable Text" FontSize="10" Foreground="#FFDDE4EE" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding QPromptText}" Margin="0,0,14,0" FontFamily="Segoe UI Variable Text" FontSize="15.5"
                                                           LineHeight="22" Foreground="{StaticResource AppleWhite}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding ClockTimeText}" FontFamily="Segoe UI Variable Text" FontSize="11.5"
                                                           Foreground="#FF7F8A9B" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <Border Padding="20,16" MinHeight="196" Background="#FF0F1722" BorderBrush="#FF2A374A" BorderThickness="1" CornerRadius="18">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Grid Width="46" Height="52" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <Border x:Name="QThinkingGlow" Width="52" Height="52" CornerRadius="26" Background="#334D9AFF" Opacity="0.18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Border Width="40" Height="40" CornerRadius="20" Background="#FF1478F2" BorderBrush="#FF58A6FF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="Q" FontFamily="Segoe UI Variable Display" FontSize="21" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <Grid Grid.Column="1" Margin="0,0,0,0">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding QShowInlineThinking, Converter={StaticResource BoolToVisibility}}">
                                                            <Ellipse x:Name="QThinkingDot1" Width="9" Height="9" Margin="0,0,8,0" Fill="#FF63ACFF" Opacity="0.25" />
                                                            <Ellipse x:Name="QThinkingDot2" Width="9" Height="9" Margin="0,0,8,0" Fill="#FF63ACFF" Opacity="0.25" />
                                                            <Ellipse x:Name="QThinkingDot3" Width="9" Height="9" Margin="0,0,10,0" Fill="#FF63ACFF" Opacity="0.25" />
                                                            <TextBlock Text="{Binding QInlineStatusText}" FontFamily="Segoe UI Variable Text" FontSize="12.5" Foreground="#FF8EC4FF" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ClockTimeText}" HorizontalAlignment="Right" FontFamily="Segoe UI Variable Text" FontSize="11.5" Foreground="#FF7F8A9B" />
                                                        <Border x:Name="QShimmer" Width="104" Height="2" Margin="0,17,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FF63ACFF" Opacity="0.15"
                                                                Visibility="{Binding QShowInlineThinking, Converter={StaticResource BoolToVisibility}}">
                                                            <Border.RenderTransform><TranslateTransform x:Name="QShimmerTransform" X="-120" /></Border.RenderTransform>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding QResponseDisplay}" Margin="0,13,32,0" MinHeight="86"
                                                               FontFamily="Segoe UI Variable Text" FontSize="15.5" LineHeight="23" LineStackingStrategy="BlockLineHeight"
                                                               Foreground="#FFE8EDF5" TextWrapping="Wrap" />
                                                    <Grid Grid.Row="2" Margin="0,16,0,0" Visibility="{Binding QShowResponseActions, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Button Click="QStop_Click" Style="{StaticResource QStopButton}" HorizontalAlignment="Left"
                                                                Visibility="{Binding QCanStop, Converter={StaticResource BoolToVisibility}}" ToolTip="Stop response" AutomationProperties.Name="Stop response">
                                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center" /><TextBlock Text="Stop" Margin="8,0,0,0" /></StackPanel>
                                                        </Button>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button x:Name="QCopyButton" Click="QCopy_Click" Style="{StaticResource QResponseActionButton}" Margin="0,0,8,0"
                                                                    Visibility="{Binding QCanCopyResponse, Converter={StaticResource BoolToVisibility}}" ToolTip="Copy response" AutomationProperties.Name="Copy response">
                                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" /><TextBlock Text="Copy" Margin="7,0,0,0" /></StackPanel>
                                                            </Button>
                                                            <Button Click="QRetry_Click" Style="{StaticResource QResponseActionButton}"
                                                                    Visibility="{Binding QCanRetry, Converter={StaticResource BoolToVisibility}}" ToolTip="Retry question" AutomationProperties.Name="Retry question">
                                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" /><TextBlock Text="Retry" Margin="7,0,0,0" /></StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                                <Button x:Name="QJumpToLatestButton" Content="&#xE74B;" Click="QJumpToLatest_Click" Style="{StaticResource QCircleButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,12" Visibility="Collapsed"
                                        ToolTip="Jump to latest response" AutomationProperties.Name="Jump to latest response" />
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,2,0,10">
                                <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                    <Border Background="#FF121923" BorderBrush="#FF2A3546" BorderThickness="1" CornerRadius="21" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Ask" Click="QAsk_Click" Style="{StaticResource QAskModeButton}" AutomationProperties.Name="Ask mode" />
                                            <Button Content="Say" Click="QSay_Click" Style="{StaticResource QSayModeButton}" AutomationProperties.Name="Say mode" />
                                        </StackPanel>
                                    </Border>
                                    <ComboBox Width="142" Height="38" Margin="10,0,0,0" Style="{StaticResource QSelectorComboBox}"
                                              ItemsSource="{Binding QModelOptions}" SelectedItem="{Binding QSelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Model" AutomationProperties.Name="Q model" />
                                    <ComboBox Width="96" Height="38" Margin="8,0,0,0" Style="{StaticResource QSelectorComboBox}"
                                              ItemsSource="{Binding QReasoningEffortOptions}" SelectedItem="{Binding QReasoningEffort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Reasoning effort" AutomationProperties.Name="Q reasoning effort" />
                                    <Button Width="138" Height="38" Margin="8,0,0,0" Style="{StaticResource QActionButton}"
                                            Content="{Binding QCodexChipText}" Command="{Binding CodexPrimaryActionCommand}"
                                            ToolTip="{Binding QCodexAccountDetails}" AutomationProperties.Name="ChatGPT Codex account"
                                            Visibility="{Binding QIsCodexSelected, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Width="38" Height="38" Margin="6,0,0,0" Style="{StaticResource QResponseActionButton}"
                                            Content="&#xE8D7;" FontFamily="Segoe Fluent Icons" Command="{Binding SignOutCodexCommand}"
                                            ToolTip="Sign out of ChatGPT / Codex" AutomationProperties.Name="Sign out of ChatGPT Codex"
                                            Visibility="{Binding QShowCodexSignOut, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Click="QNew_Click" Style="{StaticResource QActionButton}" ToolTip="Start a new question" AutomationProperties.Name="New question">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F4;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" /><TextBlock Text="New question" Margin="8,0,0,0" /></StackPanel>
                                    </Button>
                                    <Button Click="QClose_Click" Style="{StaticResource QResponseActionButton}" Margin="10,0,0,0" ToolTip="Return to the normal Dynamic Island" AutomationProperties.Name="Quit Q">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" /><TextBlock Text="Quit Q" Margin="8,0,0,0" /></StackPanel>
                                    </Button>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                              Visibility="{Binding QHasShortcuts, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding QShortcuts}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Name}" Tag="{Binding Prompt}" Click="QQuickAction_Click" Style="{StaticResource QActionButton}"
                                                        Margin="0,0,8,0" ToolTip="Run this Q prompt" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="QPromptBox" Height="58" MinHeight="58" Style="{StaticResource QComposerTextBox}"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden"
                                             ToolTip="Ask Q about the active window" AutomationProperties.Name="Q prompt"
                                             TextChanged="QPromptBox_TextChanged" KeyDown="QPromptBox_KeyDown" />
                                    <TextBlock x:Name="QPromptPlaceholder" Text="Ask a follow-up…" Margin="19,0,0,0" IsHitTestVisible="False"
                                               FontFamily="Segoe UI Variable Text" FontSize="15" Foreground="#FF7F8999"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Grid>
                                <Button Grid.Column="1" Content="&#xE720;" Click="QMic_Click" Style="{StaticResource QMicButton}" Margin="10,0,0,0"
                                        IsEnabled="{Binding QSpeechAvailable}" ToolTip="Dictate" AutomationProperties.Name="Dictate question" />
                                <Button x:Name="QSendButton" Grid.Column="2" Click="QSend_Click" Style="{StaticResource QSendButton}" Margin="10,0,0,0"
                                        ToolTip="Send question" AutomationProperties.Name="Send question">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE724;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" /><TextBlock Text="Send" Margin="9,0,0,0" /></StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Stats-heavy expanded mode, based on the earlier Premium layout. -->
                <Grid x:Name="StatsExpandedContent" Margin="14,10" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="154" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="138" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="&#xE892;" Command="{Binding PreviousCommand}" Style="{StaticResource StatsButton}" ToolTip="Previous track" />
                            <Button Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" Style="{StaticResource StatsPlayButton}" ToolTip="Play or pause" />
                            <Button Content="&#xE893;" Command="{Binding NextCommand}" Style="{StaticResource StatsButton}" ToolTip="Next track" />
                        </StackPanel>
                        <Border Margin="2,10,2,0" Padding="4" CornerRadius="14" Background="#FF1B2635" BorderBrush="#FF33465E" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="&#xE738;" Command="{Binding AdjustVolumeCommand}" CommandParameter="-2" Style="{StaticResource StatsButton}" Width="28" Height="26" FontSize="10" ToolTip="Volume down" />
                                <StackPanel Margin="7,0" VerticalAlignment="Center">
                                    <TextBlock Text="VOLUME" FontFamily="{Binding UiFontFamily}" FontSize="8" Foreground="{StaticResource AppleSecondary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding VolumeText}" FontFamily="{Binding UiFontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" HorizontalAlignment="Center" />
                                </StackPanel>
                                <Button Content="&#xE710;" Command="{Binding AdjustVolumeCommand}" CommandParameter="2" Style="{StaticResource StatsButton}" Width="28" Height="26" FontSize="10" ToolTip="Volume up" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MediaTitle}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding ExpandedMediaTitleFontSize}"
                                   FontWeight="SemiBold" Foreground="{Binding PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MediaArtist}" Margin="0,3,0,10" FontFamily="{Binding UiFontFamily}" FontSize="{Binding ExpandedMediaArtistFontSize}"
                                   Foreground="{Binding SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <Grid Height="18" Visibility="{Binding ShowMediaTimes, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar Value="{Binding MediaProgress, Mode=OneWay}" Style="{StaticResource AppleProgress}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding ShowMediaTimes, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding MediaElapsedText}" FontFamily="{Binding UiFontFamily}" FontSize="9" Foreground="{Binding SecondaryTextBrush}" />
                            <TextBlock Text="{Binding MediaTrailingTimeText}" Margin="8,0,0,0" FontFamily="{Binding UiFontFamily}" FontSize="9" Foreground="{Binding SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ShowSystemMonitor, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="RAM " FontFamily="{Binding UiFontFamily}" FontSize="9" Foreground="{Binding SecondaryTextBrush}" />
                            <TextBlock Text="{Binding RamText}" FontFamily="{Binding UiFontFamily}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" />
                            <TextBlock Text="  NETWORK " Margin="12,0,0,0" FontFamily="{Binding UiFontFamily}" FontSize="9" Foreground="{Binding SecondaryTextBrush}" />
                            <TextBlock Text="{Binding NetText}" FontFamily="{Binding UiFontFamily}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ClockText}" FontFamily="{Binding UiFontFamily}" FontSize="{Binding ClockFontSize}" FontWeight="SemiBold"
                                   Foreground="{Binding PrimaryTextBrush}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding DateText}" Margin="0,2,0,0" FontFamily="{Binding UiFontFamily}" FontSize="{Binding DateFontSize}"
                                   Foreground="{Binding SecondaryTextBrush}" HorizontalAlignment="Right" Visibility="{Binding ShowDate, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right" Visibility="{Binding ShowBattery, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding BatteryGlyph}" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{Binding SecondaryTextBrush}" />
                            <TextBlock Text="{Binding BatteryText}" Margin="4,0,0,0" FontFamily="{Binding UiFontFamily}" FontSize="10" Foreground="{Binding SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Timer and alarm are part of the island surface, not a detached utility window. -->
                <Grid x:Name="TimerPanelContent" Grid.Row="0" Grid.Column="0" Grid.RowSpan="5" Grid.ColumnSpan="3" Panel.ZIndex="100"
                      Margin="0" Background="#FF000000" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed"
                      MouseLeave="TimerPanel_MouseLeave">
                    <Grid Margin="36,22,36,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="44" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="310" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="#FF409CFF" VerticalAlignment="Center" />
                            <TextBlock Text="Timer" Margin="12,0,0,0" FontFamily="Segoe UI Variable Display" FontSize="25" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppleWhite}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Column="1" Height="48" CornerRadius="24" Background="#FF111113" BorderBrush="#FF252529" BorderThickness="1">
                            <Grid Margin="3">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button x:Name="TimerTabButton" Content="Timer" Click="TimerTab_Click" Style="{StaticResource TimerSurfaceButton}"
                                        Padding="0" Background="#FF222226" BorderBrush="#FF39393E" Foreground="#FF66ADFF" />
                                <Button x:Name="AlarmTabButton" Grid.Column="1" Content="Alarm" Click="AlarmTab_Click" Style="{StaticResource TimerSurfaceButton}"
                                        Padding="0" Background="Transparent" BorderBrush="Transparent" Foreground="#FF9C9CA2" />
                            </Grid>
                        </Border>

                        <Button Grid.Column="2" Content="&#xE711;" Click="CloseTimerPanel_Click" Style="{StaticResource AppleControlOnDark}"
                                Width="44" Height="44" FontSize="18" HorizontalAlignment="Right" ToolTip="Close timer" />
                    </Grid>

                    <Border Grid.Row="1" Background="#FF1D1D20" />

                    <Grid x:Name="TimerTabContent" Grid.Row="2" Margin="0,12,0,8"><views:TimerListPanel /></Grid>
                    <Grid x:Name="AlarmTabContent" Grid.Row="2" Margin="0,12,0,8" Visibility="Collapsed"><views:AlarmListPanel /></Grid>                    <Grid Grid.Row="3"><TextBlock x:Name="TimerFooterText" Text="{Binding TimerFooterText}" FontFamily="Segoe UI Variable Text" FontSize="14"
                                   Foreground="#FF77777D" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    </Grid>
                    </Grid>
                </Grid>

                    <Popup x:Name="OutputDevicePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=OutputDeviceButton}" StaysOpen="False" AllowsTransparency="True">
                        <Border Margin="0,8,0,0" Padding="8" MinWidth="236" CornerRadius="16" Background="#FA1C1C1E" BorderBrush="#18FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="8,5,8,7">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{StaticResource AppleSecondary}" VerticalAlignment="Center" />
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="Audio output" FontFamily="Segoe UI Variable Text" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppleSecondary}" />
                                        <TextBlock Text="{Binding OutputDeviceText}" FontFamily="Segoe UI Variable Text" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" TextTrimming="CharacterEllipsis" MaxWidth="194" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Height="1" Background="#18FFFFFF" Margin="4,0,4,4" />
                                <ItemsControl ItemsSource="{Binding OutputDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding Id}" Click="OutputDeviceItem_Click" Background="Transparent" BorderThickness="0" Padding="10,7"
                                                    HorizontalContentAlignment="Left" Foreground="{StaticResource AppleWhite}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Variable Text" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#FF0A84FF" Margin="12,0,0,0"
                                                               Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>

                </Grid></ScrollViewer>
            </Grid>
        </Border>

        <!-- Compact privacy stays minimal; expanded privacy moves into the island's Live Activity region. -->
        <Grid x:Name="PrivacyIndicatorDot" Width="18" Height="18" Margin="0,8,0,0"
              HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="21"
              RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"
              ToolTip="{Binding PrivacyDetailText}"
              AutomationProperties.Name="{Binding PrivacyDetailText}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ShowPrivacyInUse}" Value="True" />
                                <Condition Binding="{Binding IsCompact}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PrivacyDotScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PrivacyDotTranslate" X="135" Y="17" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Border CornerRadius="9" Background="#FD000000" BorderBrush="#20FFFFFF" BorderThickness="1" />
            <Ellipse Width="8" Height="8" Fill="{Binding PrivacyIndicatorBrush}" />
        </Grid>

        <!-- Apple-style compact timer activity. It is deliberately outside GlassShell so it remains
             a separate orb instead of changing the user's compact island width or media layout. -->
        <Border x:Name="UrgentAlertStrip" Panel.ZIndex="100" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,78,12,4" Padding="10,6" CornerRadius="12" Background="#FF25201A" BorderBrush="#FFFF9F0A" BorderThickness="1" MaxWidth="650" Visibility="{Binding HasUrgentAlert, Converter={StaticResource BoolToVisibility}}">
<DockPanel><Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissUrgentCommand}" Style="{StaticResource TimerSurfaceButton}" Width="78" Height="32" Margin="6,0,0,0" /><Button DockPanel.Dock="Right" Content="Snooze 5m" Command="{Binding SnoozeUrgentCommand}" Style="{StaticResource TimerSurfaceButton}" Width="92" Height="32" Visibility="{Binding CanSnoozeUrgent, Converter={StaticResource BoolToVisibility}}" /><TextBlock Text="{Binding UrgentAlertText}" Margin="0,0,12,0" Foreground="#FFFFC775" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></DockPanel>
</Border><Grid x:Name="CompactTimerOrb" Width="54" Height="54" Margin="0,8,0,0"
              HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="20"
              Visibility="{Binding ShowTimerOrb, Converter={StaticResource BoolToVisibility}}"
              Cursor="Hand" ToolTip="Hover to open timer"
              MouseEnter="TimerOrb_MouseEnter" MouseLeftButtonUp="TimerOrb_Click">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="TimerOrbTranslate" X="150" />
            </Grid.RenderTransform>
            <Border CornerRadius="30" Background="#FD000000" BorderBrush="#18FFFFFF" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="13" ShadowDepth="2" Opacity="0.42" Color="#CC000000" />
                </Border.Effect>
            </Border>
            <Ellipse Width="38" Height="38" Stroke="#FF4A3214" StrokeThickness="3" Opacity="0.72" />
            <Ellipse Width="38" Height="38" Stroke="#FFFF9F0A" StrokeThickness="3"
                     StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Ellipse.StrokeDashArray>
                    <MultiBinding Converter="{StaticResource RingProgress}">
                        <Binding Path="TimerRemainingProgress" />
                        <Binding Path="TimerOrbPerimeterUnits" />
                    </MultiBinding>
                </Ellipse.StrokeDashArray>
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-90" CenterX="19" CenterY="19" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons" FontSize="14"
                       Foreground="#FFFF9F0A" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock Text="{Binding TimerCountText}" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#FFFF9F0A" FontWeight="Bold" FontSize="11" /></Grid>

        <!-- Notifications retain their real system behaviour, but use the same quiet black material. -->
        <Grid x:Name="NotifBanner" Margin="0,292,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ShowBanner}" Value="True" />
                                <Condition Binding="{Binding IsAirPodsBannerActive}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RenderTransform><ScaleTransform x:Name="NotifScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
            <Border x:Name="NotifCard" MaxWidth="480" Padding="14,10" CornerRadius="18" Background="#FA111113" BorderBrush="#16FFFFFF" BorderThickness="1" ClipToBounds="True">
                <Border.Effect><DropShadowEffect x:Name="NotifGlow" BlurRadius="14" ShadowDepth="3" Opacity="0.42" Color="#000000" /></Border.Effect>
                <Grid>
                    <StackPanel x:Name="NotifContent">
                        <StackPanel.Effect><BlurEffect x:Name="NotifBlur" Radius="0" /></StackPanel.Effect>
                        <TextBlock Text="{Binding BannerApp}" FontFamily="Segoe UI Variable Text" FontSize="10.5" Foreground="{StaticResource AppleSecondary}" />
                        <TextBlock Text="{Binding BannerTitle}" Margin="0,2,0,0" FontFamily="Segoe UI Variable Text" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" />
                        <TextBlock Text="{Binding BannerBody}" Margin="0,2,0,0" MaxWidth="430" TextWrapping="Wrap" FontFamily="Segoe UI Variable Text" FontSize="11.5" Foreground="#FFD1D1D6" />
                    </StackPanel>
                    <Rectangle x:Name="NotifSweepRect" IsHitTestVisible="False" Opacity="0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="NotifSweep" X="-1" /></LinearGradientBrush.RelativeTransform>
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop x:Name="NotifSweepStop" Color="#70FFFFFF" Offset="0.5" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
            </Border>
        </Grid>

        <Popup x:Name="NotificationHistoryPopup" PlacementTarget="{Binding ElementName=GlassShell}" Placement="Bottom" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#FA111113" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="16" Padding="8" MinWidth="300" MaxWidth="380">
                <ItemsControl ItemsSource="{Binding NotificationHistory}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}" Click="OpenHistoryItem_Click" Background="Transparent" BorderThickness="0" Padding="8" HorizontalContentAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="{Binding App}" FontFamily="Segoe UI Variable Text" FontSize="10" Foreground="{StaticResource AppleSecondary}" />
                                    <TextBlock Text="{Binding Title}" FontFamily="Segoe UI Variable Text" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppleWhite}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>
</Window>
